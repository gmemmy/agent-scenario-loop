{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/comparison.schema.json",
  "title": "Agent Scenario Loop Comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "runId",
    "baselineRunId",
    "comparisonStatus",
    "healthStatus",
    "verdictStatus",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.(0|1)\\.0$"
    },
    "scenarioId": {
      "type": "string"
    },
    "flowId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "baselineRunId": {
      "type": "string"
    },
    "comparisonStatus": {
      "type": "string",
      "enum": ["better", "worse", "unchanged", "mixed", "inconclusive", "low_confidence"]
    },
    "healthStatus": {
      "type": "string",
      "enum": ["passed", "failed", "partial"]
    },
    "verdictStatus": {
      "type": "string",
      "enum": ["passed", "failed", "inconclusive", "not_evaluated"]
    },
    "comparisonBasis": {
      "$ref": "#/$defs/comparisonBasis"
    },
    "measurementPolicy": {
      "$ref": "#/$defs/measurementPolicy"
    },
    "metricComparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metricComparison"
      }
    },
    "nativePerformance": {
      "$ref": "#/$defs/nativePerformanceComparison"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missingRequired": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "$defs": {
    "comparisonBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "baseline", "current"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["explicit", "latest_trusted_prior"]
        },
        "baseline": {
          "$ref": "#/$defs/comparisonRunBasis"
        },
        "current": {
          "$ref": "#/$defs/comparisonRunBasis"
        },
        "selection": {
          "$ref": "#/$defs/comparisonSelectionBasis"
        }
      }
    },
    "comparisonRunBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId"],
      "properties": {
        "runId": {
          "type": "string"
        },
        "runDir": {
          "type": "string"
        },
        "healthStatus": {
          "type": "string"
        },
        "verdictStatus": {
          "type": "string"
        }
      }
    },
    "comparisonSelectionBasis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactRoot": {
          "type": "string"
        },
        "candidatesInspected": {
          "type": "integer",
          "minimum": 0
        },
        "scenarioId": {
          "type": "string"
        },
        "comparisonLane": {
          "type": "string"
        },
        "scenarioHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cohortHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selectedRunDir": {
          "type": "string"
        },
        "selectedRunId": {
          "type": "string"
        },
        "skippedCurrentRun": {
          "type": "boolean"
        },
        "trustedCandidates": {
          "type": "integer",
          "minimum": 0
        },
        "trustedPriorCandidates": {
          "type": "integer",
          "minimum": 0
        },
        "trustedComparableCandidates": {
          "type": "integer",
          "minimum": 0
        },
        "trustedScenarioContractCandidates": {
          "type": "integer",
          "minimum": 0
        },
        "trustedCohortCandidates": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metricComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit", "baseline", "current", "delta", "status"],
      "properties": {
        "name": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "enum": ["ms", "count", "bytes", "percent", "boolean"]
        },
        "baseline": {
          "type": ["number", "integer", "boolean", "null"]
        },
        "current": {
          "type": ["number", "integer", "boolean", "null"]
        },
        "delta": {
          "type": ["number", "integer", "boolean", "null"]
        },
        "status": {
          "type": "string",
          "enum": ["better", "worse", "unchanged", "inconclusive", "low_confidence"]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "measurementPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baselineSelection", "samples", "tolerance", "confidence"],
      "properties": {
        "baselineSelection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "poisoningProtection"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["explicit", "latestTrustedPrior"]
            },
            "poisoningProtection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requirePassedHealth", "requirePassedVerdict", "requireMatchingScenarioId"],
              "properties": {
                "requirePassedHealth": {
                  "type": "boolean"
                },
                "requirePassedVerdict": {
                  "type": "boolean"
                },
                "requireMatchingScenarioId": {
                  "type": "boolean"
                },
                "comparisonLane": {
                  "type": "string"
                },
                "scenarioHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "cohortHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        "samples": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "current"],
          "properties": {
            "baseline": {
              "$ref": "#/$defs/samplePolicy"
            },
            "current": {
              "$ref": "#/$defs/samplePolicy"
            }
          }
        },
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timing"],
          "properties": {
            "timing": {
              "type": "object",
              "additionalProperties": false,
              "required": ["absoluteMs", "relative"],
              "properties": {
                "absoluteMs": {
                  "type": "number",
                  "minimum": 0
                },
                "relative": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "minValidSamples"],
          "properties": {
            "level": {
              "type": "string",
              "enum": ["single_run", "multi_sample", "insufficient", "low_confidence"]
            },
            "minValidSamples": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string"
            }
          }
        }
      }
    },
    "samplePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validSamples", "warmupSamples", "outliersExcluded"],
      "properties": {
        "validSamples": {
          "type": "integer",
          "minimum": 0
        },
        "warmupSamples": {
          "type": "integer",
          "minimum": 0
        },
        "outliersExcluded": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nativePerformanceComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "metrics", "explanations"],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not-comparable"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "explanations": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["improved", "regressed", "unchanged", "mixed"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "metrics": {
                "minItems": 1
              },
              "explanations": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["improved", "regressed", "unchanged", "mixed", "not-comparable"]
        },
        "policyId": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nativePerformanceComparisonMetric"
          }
        },
        "explanations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nativePerformanceComparisonExplanation"
          }
        }
      }
    },
    "nativePerformanceComparisonExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "phase", "reason"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "missing-evidence",
            "ambiguous-evidence",
            "untrusted-evidence",
            "incompatible-run",
            "policy-mismatch",
            "invalid-metric",
            "unsupported-version"
          ]
        },
        "phase": {
          "type": "string",
          "enum": ["baseline", "current", "pair", "metric"]
        },
        "reason": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "metricId": {
          "type": "string"
        },
        "baseline": {
          "type": ["string", "number", "integer", "boolean", "null"]
        },
        "current": {
          "type": ["string", "number", "integer", "boolean", "null"]
        }
      }
    },
    "nativePerformanceComparisonMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregation",
        "baseline",
        "budget",
        "current",
        "delta",
        "direction",
        "id",
        "percentChange",
        "sample",
        "status",
        "surface",
        "unit"
      ],
      "properties": {
        "aggregation": {
          "type": "string",
          "enum": ["count", "last", "max", "mean", "p50", "p90", "p95", "p99", "sum"]
        },
        "baseline": {
          "type": ["number", "integer", "null"]
        },
        "budget": {
          "$ref": "#/$defs/nativePerformanceComparisonBudgetResult"
        },
        "current": {
          "type": ["number", "integer", "null"]
        },
        "delta": {
          "type": ["number", "integer", "null"]
        },
        "direction": {
          "type": "string",
          "enum": ["lower-is-better", "higher-is-better"]
        },
        "id": {
          "type": "string"
        },
        "percentChange": {
          "type": ["number", "integer", "null"]
        },
        "percentChangeReason": {
          "type": "string",
          "enum": ["zero-baseline"]
        },
        "sample": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["improved", "regressed", "unchanged", "not-comparable"]
        },
        "surface": {
          "type": "string",
          "enum": ["frames", "memory", "metrics"]
        },
        "unit": {
          "type": "string",
          "enum": ["ms", "count", "bytes", "percent"]
        }
      }
    },
    "nativePerformanceComparisonBudgetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": {
          "type": "string",
          "enum": ["passed", "failed", "not-configured"]
        },
        "operator": {
          "type": "string",
          "enum": ["at-most", "at-least"]
        },
        "threshold": {
          "type": ["number", "integer"]
        }
      }
    }
  }
}
