{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/health.schema.json",
  "title": "Agent Scenario Loop Health",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioId", "runId", "healthStatus", "checks"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "scenarioId": {
      "type": "string"
    },
    "flowId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "healthStatus": {
      "type": "string",
      "enum": ["passed", "failed", "partial"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/healthCheck"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/healthCheck"
      }
    },
    "matched": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "driverActions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceProviders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "source"],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "partial", "warning"]
        },
        "source": {
          "type": "string",
          "enum": ["planner", "runner", "truth", "evidence"]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      }
    }
  }
}
