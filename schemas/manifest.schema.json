{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/manifest.schema.json",
  "title": "Agent Scenario Loop Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario",
    "runId",
    "platform",
    "status",
    "startedAt",
    "endedAt",
    "durationMs",
    "interactionDriver",
    "provenance",
    "attempt",
    "environment",
    "simulator",
    "bundleId",
    "gitSha",
    "toolVersions",
    "artifacts",
    "failureReason"
  ],
  "properties": {
    "scenario": {
      "type": "string"
    },
    "scenarioHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runId": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": ["ios", "android"]
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "startedAt": {
      "type": "string"
    },
    "endedAt": {
      "type": "string"
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "interactionDriver": {
      "type": "string"
    },
    "comparisonLane": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitSha", "toolVersions"],
      "properties": {
        "scenarioHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cohort": {
          "$ref": "#/$defs/provenanceCohort"
        },
        "cohortHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "gitSha": {
          "type": "string"
        },
        "toolVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptId",
        "runId",
        "status",
        "terminalState",
        "startedAt",
        "endedAt",
        "durationMs",
        "interactionDriver",
        "classification",
        "cleanup",
        "partialArtifacts"
      ],
      "properties": {
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "attemptNumber": {
          "type": "integer",
          "minimum": 1
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "retryOfAttemptId": {
          "type": "string",
          "minLength": 1
        },
        "retryReason": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed"]
        },
        "terminalState": {
          "$ref": "#/$defs/terminalState"
        },
        "startedAt": {
          "type": "string"
        },
        "endedAt": {
          "type": "string"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "interactionDriver": {
          "type": "string"
        },
        "comparisonLane": {
          "type": "string"
        },
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category"],
          "properties": {
            "category": {
              "type": "string",
              "enum": ["none", "product", "runner", "environment", "timeout", "cancelled", "instrumentation", "evidence", "unknown"]
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["not-required", "passed", "failed", "partial", "unknown"]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "partialArtifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["valid", "reason"],
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "bundleId", "runtimeTarget", "preconditions", "postconditions"],
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["ios", "android"]
        },
        "bundleId": {
          "type": "string"
        },
        "runtimeTarget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "udid"],
          "properties": {
            "name": {
              "type": "string"
            },
            "udid": {
              "type": "string"
            }
          }
        },
        "nodeVersion": {
          "type": "string"
        },
        "preconditions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "installedState",
            "appDataState",
            "authState",
            "initialRoute",
            "foregroundState",
            "lifecyclePhase",
            "deviceLockState",
            "permissions",
            "locale",
            "timezone",
            "theme",
            "fontScale",
            "orientation",
            "networkState",
            "animations"
          ],
          "properties": {
            "installedState": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "appDataState": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "authState": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "initialRoute": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "foregroundState": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "lifecyclePhase": {
              "$ref": "#/$defs/lifecycleStateAssertion"
            },
            "deviceLockState": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "permissions": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "locale": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "timezone": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "theme": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "fontScale": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "orientation": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "networkState": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "animations": {
              "$ref": "#/$defs/lifecycleAssertion"
            }
          }
        },
        "postconditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["appState", "lifecyclePhase", "cleanupState", "dataState", "artifactState"],
          "properties": {
            "appState": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "lifecyclePhase": {
              "$ref": "#/$defs/lifecycleStateAssertion"
            },
            "cleanupState": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "dataState": {
              "$ref": "#/$defs/lifecycleAssertion"
            },
            "artifactState": {
              "$ref": "#/$defs/lifecycleAssertion"
            }
          }
        }
      }
    },
    "simulator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "udid"],
      "properties": {
        "name": {
          "type": "string"
        },
        "udid": {
          "type": "string"
        }
      }
    },
    "bundleId": {
      "type": "string"
    },
    "gitSha": {
      "type": "string"
    },
    "toolVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["causalRun", "budgetVerdict", "manifest", "metrics", "summary", "scenario", "raw", "captures", "signals"],
      "properties": {
        "causalRun": {
          "type": "string"
        },
        "budgetVerdict": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        },
        "metrics": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "raw": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interactionLog", "deviceLog"],
          "properties": {
            "interactionLog": {
              "type": "string"
            },
            "deviceLog": {
              "type": "string"
            }
          }
        },
        "captures": {
          "type": "object",
          "additionalProperties": false,
          "required": ["video", "uiTree"],
          "properties": {
            "video": {
              "type": "string"
            },
            "uiTree": {
              "type": "string"
            },
            "screenshots": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["js", "memory", "network"],
          "properties": {
            "js": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "memory": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "network": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "evidenceAttachments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channel",
              "completenessStatus",
              "corruptionStatus",
              "kind",
              "path",
              "redactionStatus",
              "sha256",
              "sizeBytes",
              "sourceFileName",
              "transformations"
            ],
            "properties": {
              "channel": {
                "type": "string",
                "enum": ["capture", "provider", "signal"]
              },
              "completenessStatus": {
                "type": "string",
                "enum": ["complete", "truncated", "unknown"]
              },
              "corruptionStatus": {
                "type": "string",
                "enum": ["valid", "corrupt", "unknown"]
              },
              "kind": {
                "type": "string",
                "enum": ["accessibility", "js", "logs", "memory", "network", "profiler", "screenshot", "uiTree", "video"]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "redactionStatus": {
                "type": "string",
                "enum": ["not-redacted", "redacted", "unknown"]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0
              },
              "sourceFileName": {
                "type": "string",
                "minLength": 1
              },
              "transformations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["copied", "normalized", "redacted", "truncated", "compressed", "transcoded", "unknown"]
                }
              }
            }
          }
        }
      }
    },
    "failureReason": {
      "type": ["string", "null"]
    }
  },
  "$defs": {
    "provenanceCohort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appVersion": {
          "type": "string"
        },
        "appId": {
          "type": "string"
        },
        "buildId": {
          "type": "string"
        },
        "buildMode": {
          "type": "string"
        },
        "commandTransport": {
          "type": "string"
        },
        "deviceClass": {
          "type": "string"
        },
        "featureFlags": {
          "type": "object",
          "additionalProperties": {
            "type": ["boolean", "string", "number", "null"]
          }
        },
        "osVersion": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        },
        "runnerName": {
          "type": "string"
        },
        "runnerVersion": {
          "type": "string"
        },
        "seedIdentity": {
          "type": "string"
        }
      }
    },
    "terminalState": {
      "type": "string",
      "enum": ["passed", "failed", "timeout", "cancelled", "aborted", "inconclusive", "unsupported", "skipped", "unhealthy"]
    },
    "lifecycleState": {
      "type": "string",
      "enum": [
        "unknown",
        "cold-launch",
        "warm-launch",
        "hot-launch",
        "resume",
        "foreground",
        "background",
        "force-stop",
        "process-death",
        "scene-recreation",
        "activity-recreation",
        "os-reclaim",
        "reboot",
        "relaunch"
      ]
    },
    "lifecycleAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence"],
      "properties": {
        "value": {
          "type": ["string", "number", "boolean", "null"]
        },
        "evidence": {
          "type": "string",
          "enum": ["not-asserted", "unknown", "asserted", "observed", "inferred"]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifecycleStateAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence"],
      "properties": {
        "value": {
          "$ref": "#/$defs/lifecycleState"
        },
        "evidence": {
          "type": "string",
          "enum": ["not-asserted", "unknown", "asserted", "observed", "inferred"]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
