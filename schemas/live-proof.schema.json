{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/live-proof.schema.json",
  "title": "Agent Scenario Loop Live Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "runId",
    "status",
    "outputDir",
    "preflight",
    "profiles",
    "comparisons",
    "comparisonCounts",
    "comparisonStatus",
    "nextAction",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "platform": {
      "type": "string",
      "enum": ["android", "ios"]
    },
    "runId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "outputDir": {
      "type": "string"
    },
    "preflight": {
      "$ref": "#/$defs/runPointer"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profilePointer"
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparisonPointer"
      }
    },
    "comparisonCounts": {
      "$ref": "#/$defs/comparisonCounts"
    },
    "comparisonStatus": {
      "type": "string",
      "enum": ["baseline_missing", "improved", "inconclusive", "not_compared", "regressed", "unchanged"]
    },
    "nextAction": {
      "$ref": "#/$defs/nextAction"
    },
    "summary": {
      "type": "string"
    }
  },
  "$defs": {
    "runPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "runDir", "summaryPath"],
      "properties": {
        "runId": {
          "type": "string"
        },
        "runDir": {
          "type": "string"
        },
        "summaryPath": {
          "type": "string"
        }
      }
    },
    "profilePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "scenarioId", "runId", "runDir", "summaryPath", "healthStatus", "verdictStatus"],
      "properties": {
        "label": {
          "type": "string"
        },
        "scenarioId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "runDir": {
          "type": "string"
        },
        "summaryPath": {
          "type": "string"
        },
        "healthStatus": {
          "type": "string",
          "enum": ["passed", "failed", "partial"]
        },
        "verdictStatus": {
          "type": "string",
          "enum": ["passed", "failed", "inconclusive", "not_evaluated"]
        }
      }
    },
    "comparisonPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "scenarioId",
        "runId",
        "status",
        "baselineDir",
        "comparisonDir",
        "summaryPath",
        "reason"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "scenarioId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["better", "worse", "unchanged", "inconclusive", "skipped"]
        },
        "baselineDir": {
          "type": ["string", "null"]
        },
        "comparisonDir": {
          "type": ["string", "null"]
        },
        "summaryPath": {
          "type": ["string", "null"]
        },
        "reason": {
          "type": ["string", "null"]
        }
      }
    },
    "comparisonCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["better", "worse", "unchanged", "inconclusive", "skipped"],
      "properties": {
        "better": {
          "type": "integer",
          "minimum": 0
        },
        "worse": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "summary"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["establish_baseline", "inspect_inconclusive", "inspect_regressions", "inspect_summary"]
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
