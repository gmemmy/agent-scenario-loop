{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/live-proof.schema.json",
  "title": "Agent Scenario Loop Live Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platform",
    "runId",
    "status",
    "outputDir",
    "preflight",
    "profiles",
    "comparisons",
    "comparisonCounts",
    "comparisonStatus",
    "nextAction",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "platform": {
      "type": "string",
      "enum": ["android", "ios"]
    },
    "runId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "outputDir": {
      "type": "string"
    },
    "preflight": {
      "$ref": "#/$defs/runPointer"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profilePointer"
      }
    },
    "interactionProofs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interactionProofPointer"
      }
    },
    "profileNativePerformance": {
      "$ref": "#/$defs/profileNativePerformance"
    },
    "profileGateProviderEvidenceNextActions": {
      "$ref": "#/$defs/profileGateProviderEvidenceNextActions"
    },
    "profileGateReadiness": {
      "$ref": "#/$defs/profileGateReadinessRollup"
    },
    "profileGateReadinessNextActions": {
      "$ref": "#/$defs/profileGateReadinessNextActions"
    },
    "profileGateRequestedDiagnostics": {
      "$ref": "#/$defs/profileGateRequestedDiagnostics"
    },
    "skippedInteractionProofs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skippedInteractionProofPointer"
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparisonPointer"
      }
    },
    "comparisonCounts": {
      "$ref": "#/$defs/comparisonCounts"
    },
    "comparisonStatus": {
      "type": "string",
      "enum": ["baseline_missing", "improved", "inconclusive", "low_confidence", "mixed", "not_compared", "regressed", "unchanged"]
    },
    "nextAction": {
      "$ref": "#/$defs/nextAction"
    },
    "summary": {
      "type": "string"
    }
  },
  "$defs": {
    "runPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "runDir", "summaryPath", "healthStatus", "verdictStatus"],
      "properties": {
        "runId": {
          "type": "string"
        },
        "runDir": {
          "type": "string"
        },
        "summaryPath": {
          "type": "string"
        },
        "healthStatus": {
          "type": "string",
          "enum": ["passed", "failed", "partial"]
        },
        "verdictStatus": {
          "type": "string",
          "enum": ["passed", "failed", "inconclusive", "not_evaluated"]
        }
      }
    },
    "profilePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "scenarioId", "runId", "runDir", "summaryPath", "healthStatus", "verdictStatus"],
      "properties": {
        "label": {
          "type": "string"
        },
        "scenarioId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "runDir": {
          "type": "string"
        },
        "summaryPath": {
          "type": "string"
        },
        "healthStatus": {
          "type": "string",
          "enum": ["passed", "failed", "partial"]
        },
        "verdictStatus": {
          "type": "string",
          "enum": ["passed", "failed", "inconclusive", "not_evaluated"]
        }
      }
    },
    "interactionProofPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "runnerId", "scenarioId", "runId", "runDir", "summaryPath", "healthStatus", "verdictStatus"],
      "properties": {
        "label": {
          "type": "string"
        },
        "runnerId": {
          "type": "string"
        },
        "scenarioId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "runDir": {
          "type": "string"
        },
        "summaryPath": {
          "type": "string"
        },
        "healthStatus": {
          "type": "string",
          "enum": ["passed", "failed", "partial"]
        },
        "verdictStatus": {
          "type": "string",
          "enum": ["passed", "failed", "inconclusive", "not_evaluated"]
        },
        "captures": {
          "type": "object",
          "additionalProperties": false,
          "required": ["screenshots"],
          "properties": {
            "screenshots": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "warnings": {
          "$ref": "#/$defs/interactionProofWarnings"
        }
      }
    },
    "interactionProofWarnings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "checks"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/interactionProofWarning"
          }
        }
      }
    },
    "interactionProofWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "code", "message"],
      "properties": {
        "name": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "nextAction": {
          "$ref": "#/$defs/skippedInteractionProofNextAction"
        }
      }
    },
    "profileNativePerformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileCount", "evidenceCount"],
      "properties": {
        "profileCount": {
          "type": "integer",
          "minimum": 1
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 1
        },
        "diagnosticSourceCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceSourceCount"
          }
        },
        "completenessStatusCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "claimSufficiencyCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "claimSufficiencyDetailCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceClaimSufficiencyDetailCount"
          }
        },
        "comparabilityCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "targetBindingCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "targetBindingDetailCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceTargetBindingDetailCount"
          }
        }
      }
    },
    "nativePerformanceClaimSufficiencyDetailCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "count"],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        },
        "missingEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supportingEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "nativePerformanceTargetBindingDetailCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "count"],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "candidateBindingStatus": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "nativePerformanceStatusCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "count"],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "nativePerformanceSourceCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "status", "count"],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "skippedInteractionProofPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "runnerId", "scenarioId", "runId", "reason", "nextAction"],
      "properties": {
        "label": {
          "type": "string"
        },
        "runnerId": {
          "type": "string"
        },
        "scenarioId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "profileGateDiagnostics": {
          "$ref": "#/$defs/profileGateDiagnostics"
        },
        "profileGateReadiness": {
          "$ref": "#/$defs/profileGateReadiness"
        },
        "nextAction": {
          "$ref": "#/$defs/skippedInteractionProofNextAction"
        }
      }
    },
    "profileGateDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "capturedDiagnosticSufficiency": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/diagnosticSufficiencyEntry"
          }
        },
        "blockingDiagnosticSufficiency": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/diagnosticSufficiencyEntry"
          }
        },
        "requestedDiagnosticInventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requestedDiagnosticInventoryEntry"
          }
        },
        "providerEvidenceNextAction": {
          "$ref": "#/$defs/skippedInteractionProofNextAction"
        },
        "nativePerformance": {
          "$ref": "#/$defs/nativePerformanceProfileGateDiagnostics"
        }
      }
    },
    "requestedDiagnosticInventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "required"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "minLength": 1
        },
        "sufficiencyStatus": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "runnerId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "diagnosticSufficiencyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nativePerformanceProfileGateDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "claimSufficiency": {
          "type": "string",
          "minLength": 1
        },
        "claimSufficiencyDetails": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceClaimSufficiencyDetail"
          }
        },
        "completenessStatus": {
          "type": "string",
          "minLength": 1
        },
        "comparability": {
          "type": "string",
          "minLength": 1
        },
        "targetBinding": {
          "type": "string",
          "minLength": 1
        },
        "targetBindingDetails": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceTargetBindingDetail"
          }
        },
        "diagnosticSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceSourceEntry"
          }
        }
      }
    },
    "profileGateReadinessRollup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skippedInteractionProofCount", "readinessProofCount"],
      "properties": {
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "readinessProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "commandCountTotal": {
          "type": "integer",
          "minimum": 0
        },
        "devClientDeepLinkOpenedCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessBooleanCount"
          }
        },
        "expectedEvidenceCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "failureClassCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "foregroundAppInfoCapturedCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessBooleanCount"
          }
        },
        "foregroundApplicationStateCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "foregroundTargetOwnedCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessBooleanCount"
          }
        },
        "pendingPhaseCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "profileSessionSeededCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessBooleanCount"
          }
        },
        "readinessDetailCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        }
      }
    },
    "profileGateProviderEvidenceNextActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skippedInteractionProofCount", "nextActionCounts"],
      "properties": {
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "nextActionCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/liveProofNextActionCount"
          }
        }
      }
    },
    "liveProofNextActionCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count"],
      "properties": {
        "owner": {
          "$ref": "#/$defs/nextActionOwner"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "profileGateReadinessNextActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skippedInteractionProofCount", "nextActionCounts"],
      "properties": {
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "nextActionCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/liveProofNextActionCount"
          }
        }
      }
    },
    "profileGateRequestedDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skippedInteractionProofCount", "requestedDiagnosticCounts"],
      "properties": {
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "requestedDiagnosticCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requestedDiagnosticInventoryCount"
          }
        }
      }
    },
    "requestedDiagnosticInventoryCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "required", "count"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "minLength": 1
        },
        "sufficiencyStatus": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "profileGateReadinessBooleanCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "count"],
      "properties": {
        "value": {
          "type": "boolean"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "profileGateReadinessValueCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "count"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "nativePerformanceClaimSufficiencyDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        },
        "missingEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supportingEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nativePerformanceTargetBindingDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "candidateBindingStatus": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nativePerformanceSourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "status"],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profileGateReadiness": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "commandCount": {
          "type": "integer",
          "minimum": 0
        },
        "devClientDeepLinkOpened": {
          "type": "boolean"
        },
        "expectedEvidence": {
          "type": "string",
          "minLength": 1
        },
        "failureClass": {
          "type": "string",
          "minLength": 1
        },
        "foregroundAppInfoCaptured": {
          "type": "boolean"
        },
        "foregroundApplicationState": {
          "type": "string",
          "minLength": 1
        },
        "foregroundRawPath": {
          "type": "string",
          "minLength": 1
        },
        "foregroundTargetOwned": {
          "type": "boolean"
        },
        "lastDeepLinkLabel": {
          "type": "string",
          "minLength": 1
        },
        "pendingPhase": {
          "type": "string",
          "minLength": 1
        },
        "profileSessionSeedRawPath": {
          "type": "string",
          "minLength": 1
        },
        "profileSessionSeeded": {
          "type": "boolean"
        },
        "readinessRawPath": {
          "type": "string",
          "minLength": 1
        },
        "readinessNextAction": {
          "$ref": "#/$defs/skippedInteractionProofNextAction"
        }
      }
    },
    "skippedInteractionProofNextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "summary"],
      "properties": {
        "code": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/nextActionOwner"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "nextActionOwner": {
      "type": "string",
      "enum": ["app_truth", "asl_runner", "product_optimization", "provider_tooling", "runtime_environment", "scenario_contract"]
    },
    "comparisonPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "scenarioId",
        "runId",
        "status",
        "baselineDir",
        "comparisonDir",
        "summaryPath",
        "reason"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "scenarioId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["better", "worse", "unchanged", "mixed", "inconclusive", "low_confidence", "skipped"]
        },
        "baselineDir": {
          "type": ["string", "null"]
        },
        "comparisonDir": {
          "type": ["string", "null"]
        },
        "summaryPath": {
          "type": ["string", "null"]
        },
        "reason": {
          "type": ["string", "null"]
        },
        "nativePerformanceStatus": {
          "type": "string",
          "enum": ["improved", "regressed", "unchanged", "mixed", "not-comparable"]
        },
        "regressionSource": {
          "type": "string",
          "enum": ["ordinary", "native-performance", "both"]
        },
        "metricSummary": {
          "$ref": "#/$defs/comparisonMetricSummary"
        }
      }
    },
    "comparisonMetricSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "notableMetrics"],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["better", "worse", "unchanged", "inconclusive", "low_confidence"],
          "properties": {
            "better": {
              "type": "integer",
              "minimum": 0
            },
            "worse": {
              "type": "integer",
              "minimum": 0
            },
            "unchanged": {
              "type": "integer",
              "minimum": 0
            },
            "inconclusive": {
              "type": "integer",
              "minimum": 0
            },
            "low_confidence": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "notableMetrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comparisonMetricHighlight"
          }
        }
      }
    },
    "comparisonMetricHighlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "unit", "baseline", "current", "delta"],
      "properties": {
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["better", "worse", "inconclusive", "low_confidence"]
        },
        "unit": {
          "type": "string"
        },
        "baseline": {
          "type": ["number", "integer", "boolean", "null"]
        },
        "current": {
          "type": ["number", "integer", "boolean", "null"]
        },
        "delta": {
          "type": ["number", "integer", "null"]
        }
      }
    },
    "comparisonCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["better", "worse", "unchanged", "mixed", "inconclusive", "low_confidence", "skipped"],
      "properties": {
        "better": {
          "type": "integer",
          "minimum": 0
        },
        "worse": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "mixed": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0
        },
        "low_confidence": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "summary"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["establish_baseline", "inspect_failed_run", "inspect_inconclusive", "inspect_low_confidence", "inspect_mixed", "inspect_regressions", "inspect_summary"]
        },
        "owner": {
          "$ref": "#/$defs/nextActionOwner"
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
