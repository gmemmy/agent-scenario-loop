{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/evidence-package.schema.json",
  "title": "Agent Scenario Loop evidence package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "runId", "status", "sensitivityPolicy", "fileCount", "totalByteSize", "checksumsPath", "entries"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0.0", "1.1.0"] },
    "packageId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "status": { "const": "complete" },
    "sensitivityPolicy": { "const": "allowlist-and-secret-marker-v1" },
    "fileCount": { "type": "integer", "minimum": 1 },
    "totalByteSize": { "type": "integer", "minimum": 1 },
    "checksumsPath": { "const": "SHA256SUMS" },
    "entries": { "$ref": "#/$defs/entries" },
    "jsonPointers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/jsonPointerRecord" } }
  },
  "if": { "properties": { "schemaVersion": { "const": "1.1.0" } }, "required": ["schemaVersion"] },
  "then": { "required": ["jsonPointers"] },
  "else": { "not": { "required": ["jsonPointers"] } },
  "$defs": {
    "runRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\\\)(?!.*\\\\)(?!.*//)(?!.*\/$)(?!.*[\\u0000-\\u001F\\u007F])(?!.*(?:^|\/)\\.\\.(?:\/|$))(?!.*(?:^|\/)\\.(?:\/|$))[^\\\\]+$"
    },
    "artifactPath": {
      "allOf": [
        { "$ref": "#/$defs/runRelativePath" },
        { "pattern": "^(?!.*(?:^|/)[^/]*[. ](?:/|$))files/.+" }
      ]
    },
    "jsonPointer": { "type": "string", "pattern": "^(|(/([^/~]|~0|~1)*)+)$" },
    "absoluteHostPath": { "type": "string", "pattern": "^(?:/.*|[A-Za-z]:[\\\\/].*|\\\\\\\\.+)$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "sourcePath", "artifactPath", "byteSize", "sha256"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["recording", "screenshot", "uiTree", "actionTranscript", "log", "metrics", "health", "verdict", "summary", "liveProof", "liveProofSet", "ciEvidencePack", "other"]
          },
          "sourcePath": { "$ref": "#/$defs/runRelativePath" },
          "artifactPath": { "$ref": "#/$defs/artifactPath" },
          "byteSize": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "jsonPointerRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactPath", "jsonPointer", "role", "value", "dereferenceable"],
      "properties": {
        "artifactPath": { "$ref": "#/$defs/artifactPath" },
        "jsonPointer": { "$ref": "#/$defs/jsonPointer" },
        "role": { "type": "string", "enum": ["artifact-reference", "host-local-provenance"] },
        "value": { "type": "string", "minLength": 1 },
        "dereferenceable": { "type": "boolean" },
        "referencedArtifactPath": { "$ref": "#/$defs/artifactPath" }
      },
      "if": { "properties": { "role": { "const": "artifact-reference" } }, "required": ["role"] },
      "then": {
        "required": ["referencedArtifactPath"],
        "properties": {
          "dereferenceable": { "const": true },
          "value": { "$ref": "#/$defs/artifactPath" }
        }
      },
      "else": {
        "not": { "required": ["referencedArtifactPath"] },
        "properties": {
          "dereferenceable": { "const": false },
          "value": { "$ref": "#/$defs/absoluteHostPath" }
        }
      }
    }
  }
}
