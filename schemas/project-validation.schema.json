{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/project-validation.schema.json",
  "title": "Agent Scenario Loop Project Validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appHelper",
    "configPath",
    "errors",
    "nextActions",
    "platform",
    "plans",
    "providerPaths",
    "rootDir",
    "runnerPath",
    "scripts",
    "scenarioPaths",
    "status",
    "warnings"
  ],
  "properties": {
    "appHelper": {
      "$ref": "#/$defs/appHelper"
    },
    "configPath": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nextAction"
      }
    },
    "platform": {
      "type": "string",
      "enum": ["ios", "android", "all"]
    },
    "plans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plan"
      }
    },
    "providerPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rootDir": {
      "type": "string"
    },
    "runnerPath": {
      "type": "string"
    },
    "scripts": {
      "$ref": "#/$defs/scripts"
    },
    "scenarioPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "appHelper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missingExports", "path", "status"],
      "properties": {
        "missingExports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["present", "missing", "incomplete"]
        }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity", "target"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning"]
        },
        "target": {
          "type": "string"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthStatus", "platform", "runId", "scenarioId", "scenarioPath"],
      "properties": {
        "healthStatus": {
          "type": "string",
          "enum": ["passed", "failed", "partial"]
        },
        "platform": {
          "type": "string",
          "enum": ["ios", "android"]
        },
        "runId": {
          "type": "string"
        },
        "scenarioId": {
          "type": "string"
        },
        "scenarioPath": {
          "type": "string"
        }
      }
    },
    "scripts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invalidScripts",
        "missingPaths",
        "missingScripts",
        "path",
        "scriptNames",
        "status",
        "unknownCommands"
      ],
      "properties": {
        "invalidScripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingScripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "string"
        },
        "scriptNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": ["present", "missing", "incomplete"]
        },
        "unknownCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
