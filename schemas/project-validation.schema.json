{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/project-validation.schema.json",
  "title": "Agent Scenario Loop Project Validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appHelper",
    "config",
    "configPath",
    "errors",
    "gitignore",
    "nextActions",
    "platform",
    "plans",
    "providerPaths",
    "rootDir",
    "runnerPath",
    "scripts",
    "scenarioCandidateDirectories",
    "scenarioPaths",
    "status",
    "warnings"
  ],
  "properties": {
    "appHelper": {
      "$ref": "#/$defs/appHelper"
    },
    "config": {
      "$ref": "#/$defs/config"
    },
    "configPath": {
      "type": "string"
    },
    "coverageInventory": {
      "$ref": "#/$defs/coverageInventory"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gitignore": {
      "$ref": "#/$defs/gitignore"
    },
    "nextActions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nextAction"
      }
    },
    "platform": {
      "type": "string",
      "enum": ["ios", "android", "all"]
    },
    "plans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plan"
      }
    },
    "providerPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rootDir": {
      "type": "string"
    },
    "runnerPath": {
      "type": "string"
    },
    "scripts": {
      "$ref": "#/$defs/scripts"
    },
    "scenarioCandidateDirectories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenarioPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "appHelper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missingExports", "path", "status"],
      "properties": {
        "missingExports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["present", "missing", "incomplete"]
        }
      }
    },
    "gitignore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missingPatterns", "path", "snippetPath", "status"],
      "properties": {
        "configArtifactPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingConfigArtifactPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "string"
        },
        "requiredPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "snippetPath": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["present", "missing", "incomplete"]
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customDrivers", "externalTargetDrivers", "invalidFields", "missingFields", "missingSupportedDrivers", "packageSupportedDrivers", "path", "status", "supportedDrivers"],
      "properties": {
        "customDrivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalTargetDrivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalidFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingSupportedDrivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packageSupportedDrivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["present", "missing", "incomplete"]
        },
        "supportedDrivers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "coverageInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "gaps", "groups", "totals"],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageInventoryField"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageInventoryGap"
          }
        },
        "groups": {
          "$ref": "#/$defs/coverageInventoryGroups"
        },
        "totals": {
          "$ref": "#/$defs/coverageInventoryTotals"
        }
      }
    },
    "coverageInventoryField": {
      "type": "string",
      "enum": ["featureSet", "behaviorContract", "variant", "coverageRole", "coverageStatus", "evidenceTier", "platformContract"]
    },
    "coverageInventoryGroupField": {
      "type": "string",
      "enum": ["featureSet", "behaviorContract", "variant", "coverageRole", "coverageStatus", "evidenceTier", "platformContract", "platform"]
    },
    "coverageInventoryGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "planCount", "platforms", "scenarioCount", "scenarioIds", "status", "value"],
      "properties": {
        "field": {
          "$ref": "#/$defs/coverageInventoryGroupField"
        },
        "planCount": {
          "type": "integer",
          "minimum": 0
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scenarioCount": {
          "type": "integer",
          "minimum": 0
        },
        "scenarioIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": ["present", "missing"]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "coverageInventoryGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missingFields", "platforms", "scenarioId", "scenarioPath", "status"],
      "properties": {
        "missingFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageInventoryField"
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scenarioId": {
          "type": "string"
        },
        "scenarioPath": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["missing", "partial"]
        }
      }
    },
    "coverageInventoryGroups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureSet", "behaviorContract", "variant", "coverageRole", "coverageStatus", "evidenceTier", "platformContract", "platform"],
      "properties": {
        "featureSet": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageInventoryGroup"
          }
        },
        "behaviorContract": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageInventoryGroup"
          }
        },
        "variant": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageInventoryGroup"
          }
        },
        "coverageRole": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageInventoryGroup"
          }
        },
        "coverageStatus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageInventoryGroup"
          }
        },
        "evidenceTier": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageInventoryGroup"
          }
        },
        "platformContract": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageInventoryGroup"
          }
        },
        "platform": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverageInventoryGroup"
          }
        }
      }
    },
    "coverageInventoryTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeCoverage", "missingCoverage", "partialCoverage", "planCount", "scenarioCount", "withCoverage"],
      "properties": {
        "completeCoverage": {
          "type": "integer",
          "minimum": 0
        },
        "missingCoverage": {
          "type": "integer",
          "minimum": 0
        },
        "partialCoverage": {
          "type": "integer",
          "minimum": 0
        },
        "planCount": {
          "type": "integer",
          "minimum": 0
        },
        "scenarioCount": {
          "type": "integer",
          "minimum": 0
        },
        "withCoverage": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity", "target"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning"]
        },
        "target": {
          "type": "string"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthStatus", "platform", "runId", "scenarioId", "scenarioPath"],
      "properties": {
        "healthStatus": {
          "type": "string",
          "enum": ["passed", "failed", "partial"]
        },
        "platform": {
          "type": "string",
          "enum": ["ios", "android"]
        },
        "runId": {
          "type": "string"
        },
        "scenarioCoverage": {
          "$ref": "#/$defs/scenarioCoverage"
        },
        "scenarioId": {
          "type": "string"
        },
        "scenarioPath": {
          "type": "string"
        }
      }
    },
    "scenarioCoverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "behaviorContract": {
          "type": "string"
        },
        "coverageRole": {
          "type": "string",
          "enum": ["canonical", "stress", "degraded", "platform-specific", "diagnostic"]
        },
        "coverageStatus": {
          "type": "string"
        },
        "evidenceTier": {
          "type": "string"
        },
        "featureSet": {
          "type": "string"
        },
        "fixtureContract": {
          "type": "string"
        },
        "ownerOnFailure": {
          "type": "string"
        },
        "platformContract": {
          "type": "string"
        },
        "riskClass": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        }
      }
    },
    "scripts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invalidScripts",
        "invalidPackageJsonScripts",
        "missingPaths",
        "missingPackageJsonScripts",
        "mismatchedPackageJsonScripts",
        "missingScripts",
        "packageJsonPath",
        "packageJsonStatus",
        "path",
        "scriptNames",
        "status",
        "unknownCommands"
      ],
      "properties": {
        "invalidScripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalidPackageJsonScripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingPackageJsonScripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mismatchedPackageJsonScripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingScripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packageJsonPath": {
          "type": "string"
        },
        "packageJsonStatus": {
          "type": "string",
          "enum": ["present", "missing", "incomplete"]
        },
        "path": {
          "type": "string"
        },
        "scriptNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": ["present", "missing", "incomplete"]
        },
        "unknownCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
