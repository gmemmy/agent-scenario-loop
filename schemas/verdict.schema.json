{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/verdict.schema.json",
  "title": "Agent Scenario Loop Verdict",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": { "const": "1.0.0" }
        },
        "required": ["schemaVersion"]
      },
      "then": {
        "not": {
          "required": ["claimResults"],
          "description": "Legacy verdict schemaVersion 1.0.0 cannot contain claim-complete results."
        }
      },
      "else": {
        "required": ["claimResults"],
        "properties": {
          "verdictStatus": {
            "type": "string",
            "enum": ["passed", "failed", "inconclusive"]
          },
          "claimResults": {
            "contains": {
              "type": "object",
              "properties": {
                "role": { "const": "mandatory" }
              },
              "required": ["role"]
            }
          }
        }
      }
    }
  ],
  "required": ["schemaVersion", "scenarioId", "runId", "healthStatus", "verdictStatus"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0"]
    },
    "scenarioId": {
      "type": "string"
    },
    "flowId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "healthStatus": {
      "type": "string",
      "enum": ["passed", "failed", "partial"]
    },
    "verdictStatus": {
      "type": "string",
      "enum": ["passed", "failed", "inconclusive", "not_evaluated"]
    },
    "budgetChecks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/budgetCheck"
      }
    },
    "claimResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claimResult"
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["better", "worse", "unchanged", "inconclusive"]
        }
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "$defs": {
    "claimResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "claimHash",
        "role",
        "status",
        "reasonCode",
        "assertionResults",
        "evidenceReferences",
        "missingProof",
        "nextActionOwner",
        "nextAction"
      ],
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "supported" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "reasonCode": { "const": "all_assertions_supported" } }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "rejected" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "reasonCode": { "const": "authoritative_evidence_rejected" } }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "not_evaluable" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "reasonCode": { "$ref": "#/$defs/notEvaluableReasonCode" } }
          }
        }
      ],
      "properties": {
        "claimId": { "$ref": "#/$defs/stableId" },
        "claimHash": { "$ref": "#/$defs/sha256" },
        "role": { "$ref": "#/$defs/claimRole" },
        "status": { "$ref": "#/$defs/claimStatus" },
        "reasonCode": { "$ref": "#/$defs/claimReasonCode" },
        "assertionResults": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertionResult" }
        },
        "evidenceReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceReference" }
        },
        "missingProof": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "nextActionOwner": { "$ref": "#/$defs/nextActionOwner" },
        "nextAction": { "type": "string", "minLength": 1 }
      }
    },
    "assertionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertionId",
        "assertionKind",
        "status",
        "reasonCode",
        "expected",
        "observed",
        "evidenceReferences",
        "rejectedEvidence",
        "missingProof"
      ],
      "allOf": [
        {
          "anyOf": [
            { "$ref": "#/$defs/eventOccurrenceResultShape" },
            { "$ref": "#/$defs/eventOrderResultShape" },
            { "$ref": "#/$defs/terminalStateResultShape" },
            { "$ref": "#/$defs/boundedCountResultShape" },
            { "$ref": "#/$defs/absenceResultShape" },
            { "$ref": "#/$defs/validatedEvidenceResultShape" }
          ]
        },
        {
          "anyOf": [
            { "$ref": "#/$defs/supportedAssertionResultShape" },
            { "$ref": "#/$defs/rejectedAssertionResultShape" },
            { "$ref": "#/$defs/notEvaluableAssertionResultShape" }
          ]
        }
      ],
      "properties": {
        "assertionId": { "$ref": "#/$defs/stableId" },
        "assertionKind": { "$ref": "#/$defs/assertionKind" },
        "status": { "$ref": "#/$defs/claimStatus" },
        "reasonCode": { "$ref": "#/$defs/claimReasonCode" },
        "expected": { "type": "object" },
        "observed": { "type": ["object", "null"] },
        "rejectedEvidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceReference" }
        },
        "missingProof": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "supportedAssertionResultShape": {
      "type": "object",
      "properties": {
        "status": { "const": "supported" },
        "reasonCode": { "const": "all_assertions_supported" },
        "evidenceReferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceReference" }
        },
        "rejectedEvidence": { "type": "array", "maxItems": 0 },
        "missingProof": { "type": "array", "maxItems": 0 }
      }
    },
    "rejectedAssertionResultShape": {
      "type": "object",
      "properties": {
        "status": { "const": "rejected" },
        "reasonCode": { "const": "authoritative_evidence_rejected" },
        "evidenceReferences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceReference" }
        },
        "rejectedEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "missingProof": { "type": "array", "maxItems": 0 }
      }
    },
    "notEvaluableAssertionResultShape": {
      "type": "object",
      "properties": {
        "status": { "const": "not_evaluable" },
        "reasonCode": { "$ref": "#/$defs/notEvaluableReasonCode" },
        "observed": { "const": null },
        "missingProof": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "eventOccurrenceResultShape": {
      "type": "object",
      "properties": {
        "assertionKind": { "const": "eventOccurrence" },
        "status": { "type": "string", "enum": ["supported", "not_evaluable"] },
        "expected": { "$ref": "#/$defs/eventOccurrenceExpectation" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "supported" } }, "required": ["status"] },
          "then": { "properties": { "observed": { "$ref": "#/$defs/eventOccurrenceObservation" } } }
        }
      ]
    },
    "eventOrderResultShape": {
      "type": "object",
      "properties": {
        "assertionKind": { "const": "eventOrder" },
        "expected": { "$ref": "#/$defs/eventOrderExpectation" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "supported" } }, "required": ["status"] },
          "then": { "properties": { "observed": { "$ref": "#/$defs/eventOrderSupportedObservation" } } }
        },
        {
          "if": { "properties": { "status": { "const": "rejected" } }, "required": ["status"] },
          "then": { "properties": { "observed": { "$ref": "#/$defs/eventOrderRejectedObservation" } } }
        }
      ]
    },
    "terminalStateResultShape": {
      "type": "object",
      "properties": {
        "assertionKind": { "const": "terminalState" },
        "expected": { "$ref": "#/$defs/terminalStateValue" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "type": "string", "enum": ["supported", "rejected"] } }, "required": ["status"] },
          "then": { "properties": { "observed": { "$ref": "#/$defs/terminalStateValue" } } }
        }
      ]
    },
    "boundedCountResultShape": {
      "type": "object",
      "properties": {
        "assertionKind": { "const": "boundedCount" },
        "expected": { "$ref": "#/$defs/boundedCountExpectation" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "type": "string", "enum": ["supported", "rejected"] } }, "required": ["status"] },
          "then": { "properties": { "observed": { "$ref": "#/$defs/countObservation" } } }
        }
      ]
    },
    "absenceResultShape": {
      "type": "object",
      "properties": {
        "assertionKind": { "const": "absence" },
        "expected": { "$ref": "#/$defs/absenceExpectation" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "supported" } }, "required": ["status"] },
          "then": { "properties": { "observed": { "$ref": "#/$defs/zeroCountObservation" } } }
        },
        {
          "if": { "properties": { "status": { "const": "rejected" } }, "required": ["status"] },
          "then": { "properties": { "observed": { "$ref": "#/$defs/positiveCountObservation" } } }
        }
      ]
    },
    "validatedEvidenceResultShape": {
      "type": "object",
      "properties": {
        "assertionKind": { "const": "validatedEvidence" },
        "expected": { "$ref": "#/$defs/validatedEvidenceExpectation" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "supported" } }, "required": ["status"] },
          "then": { "properties": { "observed": { "$ref": "#/$defs/passedEvidenceObservation" } } }
        },
        {
          "if": { "properties": { "status": { "const": "rejected" } }, "required": ["status"] },
          "then": { "properties": { "observed": { "$ref": "#/$defs/failedEvidenceObservation" } } }
        }
      ]
    },
    "assertionKind": {
      "type": "string",
      "enum": [
        "eventOccurrence",
        "eventOrder",
        "terminalState",
        "boundedCount",
        "absence",
        "validatedEvidence"
      ]
    },
    "eventOccurrenceExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": { "type": "string", "minLength": 1 }
      }
    },
    "eventOccurrenceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "matchedEvidence"],
      "properties": {
        "event": { "type": "string", "minLength": 1 },
        "matchedEvidence": { "type": "string", "minLength": 1 }
      }
    },
    "eventOrderExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeEvent", "afterEvent"],
      "properties": {
        "beforeEvent": { "type": "string", "minLength": 1 },
        "afterEvent": { "type": "string", "minLength": 1 }
      }
    },
    "eventOrderSupportedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeEvidence", "afterEvidence", "relation"],
      "properties": {
        "beforeEvidence": { "type": "string", "minLength": 1 },
        "afterEvidence": { "type": "string", "minLength": 1 },
        "relation": { "const": "before" }
      }
    },
    "eventOrderRejectedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeEvidence", "afterEvidence", "relation"],
      "properties": {
        "beforeEvidence": { "type": "string", "minLength": 1 },
        "afterEvidence": { "type": "string", "minLength": 1 },
        "relation": { "const": "after" }
      }
    },
    "terminalStateValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/claimScalar" }
      }
    },
    "claimObservationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "completeSourceRequired"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "completeSourceRequired": { "const": true }
      }
    },
    "boundedCountExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "observationWindow"],
      "anyOf": [
        { "required": ["minimum"] },
        { "required": ["maximum"] }
      ],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "observationWindow": { "$ref": "#/$defs/claimObservationWindow" },
        "minimum": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 0 }
      }
    },
    "absenceExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "observationWindow"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "observationWindow": { "$ref": "#/$defs/claimObservationWindow" }
      }
    },
    "countObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "count"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "zeroCountObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "count"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "count": { "const": 0 }
      }
    },
    "positiveCountObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "count"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "logs",
        "screenshot",
        "video",
        "uiTree",
        "memory",
        "nativePerformance",
        "network",
        "profiler",
        "accessibility",
        "signals"
      ]
    },
    "validatedEvidenceExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "validationContract"],
      "properties": {
        "artifactKind": { "$ref": "#/$defs/artifactKind" },
        "validationContract": { "type": "string", "minLength": 1 }
      }
    },
    "passedEvidenceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "validationContract", "matchedEvidence", "validationStatus"],
      "properties": {
        "artifactKind": { "$ref": "#/$defs/artifactKind" },
        "validationContract": { "type": "string", "minLength": 1 },
        "matchedEvidence": { "type": "string", "minLength": 1 },
        "validationStatus": { "const": "passed" }
      }
    },
    "failedEvidenceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "validationContract", "matchedEvidence", "validationStatus"],
      "properties": {
        "artifactKind": { "$ref": "#/$defs/artifactKind" },
        "validationContract": { "type": "string", "minLength": 1 },
        "matchedEvidence": { "type": "string", "minLength": 1 },
        "validationStatus": { "const": "failed" }
      }
    },
    "claimRole": {
      "type": "string",
      "enum": ["mandatory", "supplemental"]
    },
    "claimStatus": {
      "type": "string",
      "enum": ["supported", "rejected", "not_evaluable"]
    },
    "claimReasonCode": {
      "type": "string",
      "enum": [
        "all_assertions_supported",
        "authoritative_evidence_rejected",
        "health_gate_failed",
        "missing_authoritative_evidence",
        "partial_evidence",
        "ambiguous_evidence",
        "identity_mismatch",
        "identity_capability_unavailable",
        "authoritative_evidence_conflict",
        "unsupported_authority_path",
        "incomplete_observation_window",
        "invalid_evidence",
        "cleanup_incomplete"
      ]
    },
    "notEvaluableReasonCode": {
      "type": "string",
      "enum": [
        "health_gate_failed",
        "missing_authoritative_evidence",
        "partial_evidence",
        "ambiguous_evidence",
        "identity_mismatch",
        "identity_capability_unavailable",
        "authoritative_evidence_conflict",
        "unsupported_authority_path",
        "incomplete_observation_window",
        "invalid_evidence",
        "cleanup_incomplete"
      ]
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!\\.\\.(?:[/\\\\]|$))(?!.*[/\\\\]\\.\\.(?:[/\\\\]|$))[^\\\\]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nextActionOwner": {
      "type": "string",
      "enum": [
        "app_truth",
        "asl_runner",
        "product_optimization",
        "provider_tooling",
        "runtime_environment",
        "scenario_contract",
        "unresolved"
      ]
    },
    "claimScalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "budgetCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "metric", "unit", "expected", "actual", "pass"],
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": ["milestone", "artifact"]
        },
        "metric": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "enum": ["ms", "count", "bytes", "percent", "boolean"]
        },
        "expected": {
          "type": ["number", "integer", "boolean"]
        },
        "actual": {
          "type": ["number", "integer", "boolean", "null"]
        },
        "pass": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "unmeasurable"]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
