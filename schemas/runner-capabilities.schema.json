{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/runner-capabilities.schema.json",
  "title": "Agent Scenario Loop Runner Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runnerId", "kind", "platforms", "capabilities"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "runnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "type": "string",
      "enum": ["primary", "evidenceProvider"]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["ios", "android"]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "driverActions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/driverAction"
      }
    },
    "artifactOutputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactKind"
      }
    },
    "lifecycle": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "prepare",
          "launch",
          "startSession",
          "executeStep",
          "waitForTruthEvent",
          "captureEvidence",
          "stopSession",
          "finalize",
          "startWindow",
          "capture",
          "stopWindow"
        ]
      }
    },
    "adapterOptionsSchema": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "capability": {
      "type": "string",
      "enum": [
        "launch",
        "sessionControl",
        "command",
        "logCapture",
        "artifactWrite",
        "screenshot",
        "video",
        "uiTree",
        "memory",
        "network",
        "profiler",
        "accessibility"
      ]
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "logs",
        "screenshot",
        "video",
        "uiTree",
        "memory",
        "network",
        "profiler",
        "accessibility",
        "signals"
      ]
    },
    "driverAction": {
      "type": "string",
      "enum": [
        "tap",
        "scroll",
        "inspectTree",
        "screenshot",
        "record",
        "readLogs",
        "collectPerfSignals"
      ]
    }
  }
}
