{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/runner-capabilities.schema.json",
  "title": "Agent Scenario Loop Runner Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runnerId", "kind", "platforms", "capabilities"],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "primary"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "not": {
          "description": "Primary runner manifests cannot declare providerCommands; use an evidenceProvider manifest for command-backed evidence.",
          "required": ["providerCommands"]
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "runnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "type": "string",
      "enum": ["primary", "evidenceProvider"]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["ios", "android"]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "driverActions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/driverAction"
      }
    },
    "uiContexts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uiContext"
      }
    },
    "artifactOutputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactKind"
      }
    },
    "lifecycle": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "prepare",
          "launch",
          "startSession",
          "executeStep",
          "waitForTruthEvent",
          "captureEvidence",
          "stopSession",
          "finalize",
          "startWindow",
          "capture",
          "stopWindow",
          "afterCapture",
          "postRun"
        ]
      }
    },
    "adapterOptionsSchema": {
      "type": "object",
      "additionalProperties": true
    },
    "providerCommands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/providerCommand"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "string",
      "enum": [
        "launch",
        "sessionControl",
        "command",
        "logCapture",
        "artifactWrite",
        "screenshot",
        "video",
        "uiTree",
        "memory",
        "nativePerformance",
        "network",
        "profiler",
        "accessibility"
      ]
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "logs",
        "screenshot",
        "video",
        "uiTree",
        "memory",
        "nativePerformance",
        "network",
        "profiler",
        "accessibility",
        "signals"
      ]
    },
    "driverAction": {
      "type": "string",
      "enum": [
        "tap",
        "scroll",
        "assertVisible",
        "inspectTree",
        "screenshot",
        "record",
        "readLogs",
        "collectPerfSignals"
      ]
    },
    "uiContext": {
      "type": "string",
      "enum": [
        "app",
        "systemDialog",
        "notificationShade",
        "externalBrowser",
        "webView",
        "shareSheet",
        "picker",
        "otherApp"
      ]
    },
    "providerCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "command", "outputs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "phase": {
          "type": "string",
          "enum": ["prepare", "startWindow", "capture", "stopWindow", "afterCapture", "postRun", "finalize"]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/providerCommandOutput"
          }
        }
      }
    },
    "providerCommandOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "kind", "path"],
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["capture", "provider", "signal"]
        },
        "kind": {
          "type": "string",
          "enum": [
            "accessibility",
            "js",
            "logs",
            "memory",
            "nativePerformance",
            "network",
            "profiler",
            "screenshot",
            "uiTree",
            "video"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean",
          "description": "Marks this provider output as required evidence for diagnostic inventory and health evaluation when the output is not captured."
        }
      }
    }
  }
}
