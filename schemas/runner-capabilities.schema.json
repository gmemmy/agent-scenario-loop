{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/runner-capabilities.schema.json",
  "title": "Agent Scenario Loop Runner Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runnerId", "kind", "platforms", "capabilities"],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "primary"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "not": {
          "description": "Primary runner manifests cannot declare providerCommands; use an evidenceProvider manifest for command-backed evidence.",
          "required": ["providerCommands"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "primary"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "not": {
          "description": "Primary runner manifests cannot declare exclusiveResources; live resource ownership belongs to evidence providers.",
          "required": ["exclusiveResources"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.0.0"
          }
        },
        "required": ["schemaVersion"]
      },
      "then": {
        "not": {
          "description": "exclusiveResources require schemaVersion 1.1.0.",
          "required": ["exclusiveResources"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "platforms": {
            "not": {
              "contains": {
                "const": "android"
              }
            }
          }
        },
        "required": ["platforms"]
      },
      "then": {
        "properties": {
          "providerCommands": {
            "items": {
              "properties": {
                "platforms": {
                  "not": {
                    "description": "Provider command platforms must narrow the provider manifest platform set.",
                    "contains": {
                      "const": "android"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platforms": {
            "not": {
              "contains": {
                "const": "ios"
              }
            }
          }
        },
        "required": ["platforms"]
      },
      "then": {
        "properties": {
          "providerCommands": {
            "items": {
              "properties": {
                "platforms": {
                  "not": {
                    "description": "Provider command platforms must narrow the provider manifest platform set.",
                    "contains": {
                      "const": "ios"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.(0|1)\\.0$"
    },
    "runnerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "type": "string",
      "enum": ["primary", "evidenceProvider"]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["ios", "android"]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "driverActions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/driverAction"
      }
    },
    "uiContexts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uiContext"
      }
    },
    "artifactOutputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifactKind"
      }
    },
    "lifecycle": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "prepare",
          "launch",
          "startSession",
          "executeStep",
          "waitForTruthEvent",
          "captureEvidence",
          "stopSession",
          "finalize",
          "startWindow",
          "capture",
          "stopWindow",
          "afterCapture",
          "postRun"
        ]
      }
    },
    "adapterOptionsSchema": {
      "type": "object",
      "additionalProperties": true
    },
    "providerCommands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/providerCommand"
      }
    },
    "exclusiveResources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/exclusiveResourceClaim"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "string",
      "enum": [
        "launch",
        "sessionControl",
        "command",
        "logCapture",
        "artifactWrite",
        "screenshot",
        "video",
        "uiTree",
        "memory",
        "nativePerformance",
        "network",
        "profiler",
        "accessibility"
      ]
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "logs",
        "screenshot",
        "video",
        "uiTree",
        "memory",
        "nativePerformance",
        "network",
        "profiler",
        "accessibility",
        "signals"
      ]
    },
    "driverAction": {
      "type": "string",
      "enum": [
        "tap",
        "longPress",
        "scroll",
        "swipe",
        "drag",
        "pinch",
        "rotate",
        "rotateGesture",
        "typeText",
        "focus",
        "fill",
        "pressKey",
        "pressButton",
        "assertVisible",
        "inspectTree",
        "screenshot",
        "record",
        "readLogs",
        "collectPerfSignals",
        "customGesture",
        "runSequence"
      ]
    },
    "uiContext": {
      "type": "string",
      "enum": [
        "app",
        "systemDialog",
        "notificationShade",
        "externalBrowser",
        "webView",
        "shareSheet",
        "picker",
        "otherApp"
      ]
    },
    "providerCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "command", "outputs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "phase": {
          "type": "string",
          "enum": ["prepare", "startWindow", "capture", "stopWindow", "afterCapture", "postRun", "finalize"],
          "description": "Provider command lifecycle phase. Live adb/simctl profile runners can schedule startWindow and stopWindow around the active capture loop, still treat capture as a legacy afterCapture alias, and run finalize after provider normalization. Fixture, rehydrated, and profile-mobile-only runs still fail closed for live-window phases."
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ios", "android"]
          },
          "description": "Optional command-level platform applicability. Omit to run on every platform supported by the provider manifest."
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/providerCommandOutput"
          }
        }
      }
    },
    "providerCommandOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "kind", "path"],
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["capture", "provider", "signal"]
        },
        "kind": {
          "type": "string",
          "enum": [
            "accessibility",
            "js",
            "logs",
            "memory",
            "nativePerformance",
            "network",
            "profiler",
            "screenshot",
            "uiTree",
            "video"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean",
          "description": "Marks this provider output as required evidence for diagnostic inventory and health evaluation when the output is not captured."
        },
        "redactionStatus": {
          "type": "string",
          "enum": ["not-redacted", "redacted", "unknown"],
          "description": "Producer-declared privacy status for this output. Omit or use unknown when the provider has not inspected or transformed the artifact for sensitive data."
        }
      }
    },
    "exclusiveResourceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "acquireAt", "releaseAfter", "resource"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "acquireAt": {
          "type": "string",
          "enum": ["startWindow", "afterCapture", "stopWindow", "postRun", "finalize"]
        },
        "releaseAfter": {
          "type": "string",
          "enum": ["startWindow", "afterCapture", "stopWindow", "postRun", "finalize"]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ios", "android"]
          }
        },
        "resource": {
          "$ref": "#/$defs/exclusiveResourceDescriptor"
        }
      }
    },
    "exclusiveResourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["provider", "tcpPort"]
        },
        "providerId": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "enum": ["selected-target"]
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "provider"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["providerId"],
            "not": {
              "anyOf": [
                {
                  "required": ["host"]
                },
                {
                  "required": ["port"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tcpPort"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["host", "port"],
            "not": {
              "anyOf": [
                {
                  "required": ["providerId"]
                },
                {
                  "required": ["target"]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
