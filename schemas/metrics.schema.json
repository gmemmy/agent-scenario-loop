{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/metrics.schema.json",
  "title": "Agent Scenario Loop Profile Metrics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario",
    "runId",
    "status",
    "iterations",
    "durationsMs",
    "p50Ms",
    "p95Ms",
    "failures",
    "timeouts",
    "openDurationsMs",
    "closeDurationsMs",
    "incompleteIterations",
    "artifacts"
  ],
  "properties": {
    "scenario": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "iterations": {
      "type": "integer",
      "minimum": 1
    },
    "durationsMs": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "p50Ms": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "p95Ms": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "failures": {
      "type": "integer",
      "minimum": 0
    },
    "timeouts": {
      "type": "integer",
      "minimum": 0
    },
    "openDurationsMs": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "closeDurationsMs": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "incompleteIterations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true
    },
    "measurementPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "confidence"],
      "properties": {
        "samples": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectedIterations", "validLatencySamples", "warmupSamples", "outliersExcluded"],
          "properties": {
            "expectedIterations": {
              "type": "integer",
              "minimum": 1
            },
            "validLatencySamples": {
              "type": "integer",
              "minimum": 0
            },
            "warmupSamples": {
              "type": "integer",
              "minimum": 0
            },
            "outliersExcluded": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level"],
          "properties": {
            "level": {
              "type": "string",
              "enum": ["multi_sample", "single_run", "insufficient", "unmeasurable"]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "nextAction": {
              "type": "string",
              "minLength": 1
            },
            "nextActionCode": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "budgetEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "pass", "checks", "failedChecks"],
      "properties": {
        "metric": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "partial"]
        },
        "pass": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/budgetCheck"
          }
        },
        "failedChecks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unmeasurableChecks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "budgetCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "actual", "limit", "pass", "unit"],
      "properties": {
        "name": {
          "type": "string"
        },
        "actual": {
          "type": ["number", "integer", "boolean", "null"]
        },
        "limit": {
          "type": ["number", "integer", "boolean"]
        },
        "pass": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "unmeasurable"]
        },
        "code": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "enum": ["ms", "count", "bytes", "percent", "boolean"]
        }
      }
    }
  }
}
