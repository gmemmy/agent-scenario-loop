{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/live-proof-set.schema.json",
  "title": "Agent Scenario Loop Live Proof Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "proofCount",
    "requiredPlatforms",
    "presentPlatforms",
    "missingPlatforms",
    "proofs",
    "failureReasons",
    "nextAction",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "runId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "proofCount": {
      "type": "integer",
      "minimum": 0
    },
    "requiredPlatforms": {
      "$ref": "#/$defs/platformList"
    },
    "presentPlatforms": {
      "$ref": "#/$defs/platformList"
    },
    "profileNativePerformance": {
      "$ref": "#/$defs/profileNativePerformance"
    },
    "missingPlatforms": {
      "$ref": "#/$defs/platformList"
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proofPointer"
      }
    },
    "failureReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nextAction": {
      "$ref": "#/$defs/nextAction"
    },
    "summary": {
      "type": "string"
    }
  },
  "$defs": {
    "platform": {
      "type": "string",
      "enum": ["android", "ios"]
    },
    "platformList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform"
      },
      "uniqueItems": true
    },
    "proofPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filePath",
        "platform",
        "runId",
        "status",
        "comparisonStatus",
        "summaryPath",
        "profileCount",
        "interactionProofCount",
        "interactionWarningCount",
        "nextAction"
      ],
      "properties": {
        "filePath": {
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed"]
        },
        "comparisonStatus": {
          "type": "string",
          "enum": ["baseline_missing", "improved", "inconclusive", "low_confidence", "mixed", "not_compared", "regressed", "unchanged"]
        },
        "summaryPath": {
          "type": "string"
        },
        "profileCount": {
          "type": "integer",
          "minimum": 0
        },
        "interactionProofCount": {
          "type": "integer",
          "minimum": 0
        },
        "interactionWarningCount": {
          "type": "integer",
          "minimum": 0
        },
        "interactionWarnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interactionWarningPointer"
          }
        },
        "nextAction": {
          "$ref": "#/$defs/nextAction"
        }
      }
    },
    "profileNativePerformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileCount", "evidenceCount"],
      "properties": {
        "profileCount": {
          "type": "integer",
          "minimum": 1
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 1
        },
        "diagnosticSourceCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceSourceCount"
          }
        },
        "claimSufficiencyCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "comparabilityCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "targetBindingCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        }
      }
    },
    "nativePerformanceStatusCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "count"],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "nativePerformanceSourceCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "status", "count"],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "interactionWarningPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "runnerId", "scenarioId", "runId", "checks"],
      "properties": {
        "label": {
          "type": "string"
        },
        "runnerId": {
          "type": "string"
        },
        "scenarioId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/interactionWarningCheck"
          }
        }
      }
    },
    "interactionWarningCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "code", "message"],
      "properties": {
        "name": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "nextAction": {
          "$ref": "#/$defs/nextAction"
        }
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "summary"],
      "properties": {
        "code": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/nextActionOwner"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "nextActionOwner": {
      "type": "string",
      "enum": ["app_truth", "asl_runner", "product_optimization", "provider_tooling", "runtime_environment", "scenario_contract"]
    }
  }
}
