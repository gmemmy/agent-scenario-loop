{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/live-proof-set.schema.json",
  "title": "Agent Scenario Loop Live Proof Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "proofCount",
    "requiredPlatforms",
    "presentPlatforms",
    "missingPlatforms",
    "proofs",
    "failureReasons",
    "nextAction",
    "summary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "runId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed"]
    },
    "proofCount": {
      "type": "integer",
      "minimum": 0
    },
    "skippedInteractionProofCount": {
      "type": "integer",
      "minimum": 1
    },
    "skippedInteractionProofNextActions": {
      "$ref": "#/$defs/skippedInteractionProofNextActions"
    },
    "missingPlatformNextActions": {
      "$ref": "#/$defs/missingPlatformNextActions"
    },
    "requiredPlatforms": {
      "$ref": "#/$defs/platformList"
    },
    "presentPlatforms": {
      "$ref": "#/$defs/platformList"
    },
    "profileGateDiagnosticSufficiency": {
      "$ref": "#/$defs/profileGateDiagnosticSufficiency"
    },
    "proofFailureDiagnosticSufficiency": {
      "$ref": "#/$defs/proofFailureDiagnosticSufficiency"
    },
    "profileGateNativePerformance": {
      "$ref": "#/$defs/profileGateNativePerformance"
    },
    "proofFailureNativePerformance": {
      "$ref": "#/$defs/proofFailureNativePerformance"
    },
    "profileGateProviderEvidenceNextActions": {
      "$ref": "#/$defs/profileGateProviderEvidenceNextActions"
    },
    "proofFailureProviderEvidenceNextActions": {
      "$ref": "#/$defs/proofFailureProviderEvidenceNextActions"
    },
    "proofFailureRequestedDiagnostics": {
      "$ref": "#/$defs/proofFailureRequestedDiagnostics"
    },
    "profileGateReadiness": {
      "$ref": "#/$defs/profileGateReadinessRollup"
    },
    "profileNativePerformance": {
      "$ref": "#/$defs/profileNativePerformance"
    },
    "interactionWarningNextActions": {
      "$ref": "#/$defs/interactionWarningNextActions"
    },
    "proofFailureNextActions": {
      "$ref": "#/$defs/proofFailureNextActions"
    },
    "proofFailureReadiness": {
      "$ref": "#/$defs/proofFailureReadiness"
    },
    "missingPlatforms": {
      "$ref": "#/$defs/platformList"
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proofPointer"
      }
    },
    "skippedInteractionProofs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skippedInteractionProofPointer"
      }
    },
    "failureReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nextAction": {
      "$ref": "#/$defs/nextAction"
    },
    "summary": {
      "type": "string"
    }
  },
  "$defs": {
    "platform": {
      "type": "string",
      "enum": ["android", "ios"]
    },
    "platformList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform"
      },
      "uniqueItems": true
    },
    "proofPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filePath",
        "platform",
        "runId",
        "status",
        "comparisonStatus",
        "summaryPath",
        "profileCount",
        "interactionProofCount",
        "interactionWarningCount",
        "nextAction"
      ],
      "properties": {
        "filePath": {
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed"]
        },
        "comparisonStatus": {
          "type": "string",
          "enum": ["baseline_missing", "improved", "inconclusive", "low_confidence", "mixed", "not_compared", "regressed", "unchanged"]
        },
        "summaryPath": {
          "type": "string"
        },
        "profileCount": {
          "type": "integer",
          "minimum": 0
        },
        "interactionProofCount": {
          "type": "integer",
          "minimum": 0
        },
        "interactionWarningCount": {
          "type": "integer",
          "minimum": 0
        },
        "interactionWarnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interactionWarningPointer"
          }
        },
        "nextAction": {
          "$ref": "#/$defs/nextAction"
        }
      }
    },
    "profileNativePerformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileCount", "evidenceCount"],
      "properties": {
        "profileCount": {
          "type": "integer",
          "minimum": 1
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 1
        },
        "diagnosticSourceCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceSourceCount"
          }
        },
        "completenessStatusCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "claimSufficiencyCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "comparabilityCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "targetBindingCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        }
      }
    },
    "nativePerformanceStatusCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "count"],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "nativePerformanceSourceCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "status", "count"],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "profileGateDiagnosticSufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skippedInteractionProofCount"],
      "properties": {
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "capturedDiagnosticSufficiencyCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/diagnosticSufficiencyCount"
          }
        },
        "blockingDiagnosticSufficiencyCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/diagnosticSufficiencyCount"
          }
        }
      }
    },
    "proofFailureDiagnosticSufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failedProofCount", "skippedInteractionProofCount"],
      "properties": {
        "failedProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "capturedDiagnosticSufficiencyCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/diagnosticSufficiencyCount"
          }
        },
        "blockingDiagnosticSufficiencyCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/diagnosticSufficiencyCount"
          }
        }
      }
    },
    "diagnosticSufficiencyCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "count"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "proofFailureRequestedDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failedProofCount", "skippedInteractionProofCount", "requestedDiagnosticCounts"],
      "properties": {
        "failedProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "requestedDiagnosticCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requestedDiagnosticInventoryCount"
          }
        }
      }
    },
    "requestedDiagnosticInventoryCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "required", "count"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "minLength": 1
        },
        "sufficiencyStatus": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "profileGateNativePerformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skippedInteractionProofCount"],
      "properties": {
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "diagnosticSourceCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceSourceCount"
          }
        },
        "completenessStatusCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "claimSufficiencyCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "comparabilityCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "targetBindingCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        }
      }
    },
    "proofFailureNativePerformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failedProofCount", "skippedInteractionProofCount"],
      "properties": {
        "failedProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "diagnosticSourceCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceSourceCount"
          }
        },
        "completenessStatusCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "claimSufficiencyCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "comparabilityCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        },
        "targetBindingCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nativePerformanceStatusCount"
          }
        }
      }
    },
    "profileGateReadinessRollup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skippedInteractionProofCount", "readinessProofCount"],
      "properties": {
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "readinessProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "commandCountTotal": {
          "type": "integer",
          "minimum": 0
        },
        "devClientDeepLinkOpenedCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessBooleanCount"
          }
        },
        "expectedEvidenceCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "failureClassCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "foregroundAppInfoCapturedCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessBooleanCount"
          }
        },
        "foregroundApplicationStateCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "foregroundTargetOwnedCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessBooleanCount"
          }
        },
        "pendingPhaseCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "readinessDetailCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "profileSessionSeededCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessBooleanCount"
          }
        }
      }
    },
    "proofFailureReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failedProofCount", "skippedInteractionProofCount", "readinessProofCount"],
      "properties": {
        "failedProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "readinessProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "commandCountTotal": {
          "type": "integer",
          "minimum": 0
        },
        "devClientDeepLinkOpenedCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessBooleanCount"
          }
        },
        "expectedEvidenceCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "failureClassCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "foregroundAppInfoCapturedCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessBooleanCount"
          }
        },
        "foregroundApplicationStateCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "foregroundTargetOwnedCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessBooleanCount"
          }
        },
        "pendingPhaseCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "readinessDetailCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessValueCount"
          }
        },
        "profileSessionSeededCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/profileGateReadinessBooleanCount"
          }
        }
      }
    },
    "profileGateReadinessBooleanCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "value"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "type": "boolean"
        }
      }
    },
    "profileGateReadinessValueCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "value"],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "skippedInteractionProofPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "proofRunId",
        "proofFilePath",
        "label",
        "runnerId",
        "scenarioId",
        "runId",
        "reason",
        "nextAction"
      ],
      "properties": {
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "proofRunId": {
          "type": "string"
        },
        "proofFilePath": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "runnerId": {
          "type": "string"
        },
        "scenarioId": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "profileGateDiagnostics": {
          "$ref": "#/$defs/profileGateDiagnostics"
        },
        "profileGateReadiness": {
          "$ref": "#/$defs/profileGateReadiness"
        },
        "nextAction": {
          "$ref": "#/$defs/nextAction"
        }
      }
    },
    "skippedInteractionProofNextActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skippedInteractionProofCount", "nextActionCounts"],
      "properties": {
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "nextActionCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/skippedInteractionProofNextActionCount"
          }
        }
      }
    },
    "skippedInteractionProofNextActionCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count"],
      "properties": {
        "owner": {
          "$ref": "#/$defs/nextActionOwner"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "missingPlatformNextActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missingPlatformCount", "nextActionCounts"],
      "properties": {
        "missingPlatformCount": {
          "type": "integer",
          "minimum": 1
        },
        "nextActionCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/missingPlatformNextActionCount"
          }
        }
      }
    },
    "missingPlatformNextActionCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count"],
      "properties": {
        "owner": {
          "$ref": "#/$defs/nextActionOwner"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "proofFailureNextActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proofCount", "failedProofCount", "regressedProofCount", "nextActionCounts"],
      "properties": {
        "proofCount": {
          "type": "integer",
          "minimum": 1
        },
        "failedProofCount": {
          "type": "integer",
          "minimum": 0
        },
        "regressedProofCount": {
          "type": "integer",
          "minimum": 0
        },
        "nextActionCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/proofFailureNextActionCount"
          }
        }
      }
    },
    "proofFailureNextActionCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count"],
      "properties": {
        "owner": {
          "$ref": "#/$defs/nextActionOwner"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "profileGateProviderEvidenceNextActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skippedInteractionProofCount", "nextActionCounts"],
      "properties": {
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "nextActionCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/skippedInteractionProofNextActionCount"
          }
        }
      }
    },
    "proofFailureProviderEvidenceNextActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failedProofCount", "skippedInteractionProofCount", "nextActionCounts"],
      "properties": {
        "failedProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "skippedInteractionProofCount": {
          "type": "integer",
          "minimum": 1
        },
        "nextActionCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/proofFailureNextActionCount"
          }
        }
      }
    },
    "interactionWarningNextActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proofCount", "interactionWarningCount", "nextActionCounts"],
      "properties": {
        "proofCount": {
          "type": "integer",
          "minimum": 1
        },
        "interactionWarningCount": {
          "type": "integer",
          "minimum": 1
        },
        "nextActionCounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/interactionWarningNextActionCount"
          }
        }
      }
    },
    "interactionWarningNextActionCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count"],
      "properties": {
        "owner": {
          "$ref": "#/$defs/nextActionOwner"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "profileGateDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "capturedDiagnosticSufficiency": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/diagnosticSufficiencyEntry"
          }
        },
        "blockingDiagnosticSufficiency": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/diagnosticSufficiencyEntry"
          }
        },
        "requestedDiagnosticInventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requestedDiagnosticInventoryEntry"
          }
        },
        "providerEvidenceNextAction": {
          "$ref": "#/$defs/nextAction"
        },
        "nativePerformance": {
