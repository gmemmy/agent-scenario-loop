{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/profiler.schema.json",
  "title": "Agent Scenario Loop Profiler Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "providerId", "platform", "runId", "scenarioId"],
  "anyOf": [
    { "required": ["summary"] },
    { "required": ["samples"] },
    { "required": ["metrics"] },
    { "required": ["events"] },
    { "required": ["traces"] },
    { "required": ["profile"] },
    { "required": ["attachments"] }
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "enum": ["android", "ios", "unknown"]
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capturedAt": {
      "type": "string",
      "minLength": 1
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "clockDomain": {
      "type": "string",
      "minLength": 1
    },
    "completenessStatus": {
      "type": "string",
      "enum": ["complete", "partial", "truncated", "failed", "unknown"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "traces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "string", "boolean", "null"]
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": true
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
