{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/profiler.schema.json",
  "title": "Agent Scenario Loop Profiler Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "providerId", "platform", "runId", "scenarioId"],
  "allOf": [
    {
      "if": {
        "properties": {
          "comparability": {
            "type": "object",
            "properties": {
              "status": { "const": "comparable" }
            },
            "required": ["status"]
          }
        },
        "required": ["comparability"]
      },
      "then": {
        "required": ["tool", "captureMode", "completenessStatus", "targetBinding"],
        "properties": {
          "tool": {
            "type": "object",
            "required": ["name"]
          },
          "captureMode": {
            "enum": ["passive-report", "session", "inline", "afterCapture", "postRun", "rehydrated"]
          },
          "completenessStatus": {
            "const": "complete"
          },
          "targetBinding": {
            "type": "object",
            "properties": {
              "status": { "const": "verified" }
            },
            "required": ["status"]
          }
        }
      }
    }
  ],
  "anyOf": [
    { "required": ["summary"] },
    { "required": ["samples"] },
    { "required": ["metrics"] },
    { "required": ["events"] },
    { "required": ["traces"] },
    { "required": ["profile"] },
    { "required": ["attachments"] }
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "enum": ["android", "ios", "unknown"]
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capturedAt": {
      "type": "string",
      "minLength": 1
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "clockDomain": {
      "type": "string",
      "minLength": 1
    },
    "captureMode": {
      "type": "string",
      "enum": ["passive-report", "session", "inline", "afterCapture", "postRun", "rehydrated", "unknown"]
    },
    "profileKind": {
      "type": "string",
      "enum": ["raw-profile", "cpu-summary", "render-summary", "commit-log", "trace", "native-trace", "diagnostic-summary", "mixed", "unknown"]
    },
    "dataClasses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["cpu-samples", "react-commits", "render-events", "js-thread-stalls", "native-trace", "network", "memory", "frames", "unknown"]
      },
      "uniqueItems": true
    },
    "completenessStatus": {
      "type": "string",
      "enum": ["complete", "partial", "truncated", "failed", "unknown"]
    },
    "comparability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["comparable", "diagnostic-only", "captured-not-comparable", "low-confidence", "incomplete", "unknown"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["beforeRun", "activeLoop", "afterCapture", "postRun", "rehydrated", "unknown"]
        },
        "startedAt": {
          "type": "string",
          "minLength": 1
        },
        "endedAt": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "perturbsTiming": {
          "type": "boolean"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "minLength": 1
              },
              "atMs": {
                "type": "number",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "targetBinding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["ambiguous", "mismatch"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["candidateTargets"]
          }
        }
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "ambiguous", "unverified", "mismatch", "unknown"]
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "appId": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "candidateTargets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["bindingStatus"],
            "anyOf": [
              { "required": ["deviceId"] },
              { "required": ["appId"] },
              { "required": ["source"] },
              { "required": ["evidencePath"] },
              { "required": ["reason"] }
            ],
            "properties": {
              "platform": {
                "type": "string",
                "enum": ["android", "ios", "unknown"]
              },
              "deviceId": {
                "type": "string",
                "minLength": 1
              },
              "deviceName": {
                "type": "string",
                "minLength": 1
              },
              "appId": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "evidencePath": {
                "type": "string",
                "minLength": 1
              },
              "bindingStatus": {
                "type": "string",
                "enum": ["expected", "observed", "conflicting", "unverified", "unknown"]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "traces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "string", "boolean", "null"]
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": true
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
