{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/native-performance.schema.json",
  "title": "Agent Scenario Loop Native Performance Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "providerId", "platform", "runId", "scenarioId"],
  "anyOf": [
    { "required": ["summary"] },
    { "required": ["metrics"] },
    { "required": ["frames"] },
    { "required": ["memory"] },
    { "required": ["events"] },
    { "required": ["traces"] },
    { "required": ["attachments"] }
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "enum": ["android", "ios", "unknown"]
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capturedAt": {
      "type": "string",
      "minLength": 1
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "clockDomain": {
      "type": "string",
      "minLength": 1
    },
    "captureMode": {
      "type": "string",
      "enum": ["passive-report", "session", "inline", "afterCapture", "postRun", "rehydrated", "unknown"]
    },
    "evidenceKind": {
      "type": "string",
      "enum": ["perfetto", "trace-processor", "gfxinfo", "framestats", "meminfo", "logcat-render", "instruments", "metrickit", "simctl", "native-trace", "diagnostic-summary", "mixed", "unknown"]
    },
    "dataClasses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["frames", "jank", "render", "memory", "cpu", "thread-scheduling", "io", "gpu", "network", "thermal", "battery", "native-trace", "unknown"]
      },
      "uniqueItems": true
    },
    "completenessStatus": {
      "type": "string",
      "enum": ["complete", "partial", "truncated", "failed", "unknown"]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "missing", "corrupt", "redacted", "unknown"]
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "redactionStatus": {
          "type": "string",
          "enum": ["none", "redacted", "contains-sensitive-data", "unknown"]
        },
        "corruptionStatus": {
          "type": "string",
          "enum": ["none", "corrupt", "unknown"]
        }
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["comparable", "diagnostic-only", "captured-not-comparable", "low-confidence", "incomplete", "unknown"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["beforeRun", "activeLoop", "afterCapture", "postRun", "rehydrated", "unknown"]
        },
        "startedAt": {
          "type": "string",
          "minLength": 1
        },
        "endedAt": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "perturbsTiming": {
          "type": "boolean"
        }
      }
    },
    "targetBinding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "ambiguous", "unverified", "mismatch", "unknown"]
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "appId": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "string", "boolean", "null"]
      }
    },
    "frames": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "string", "boolean", "null"]
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "string", "boolean", "null"]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "traces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
