{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/native-performance.schema.json",
  "title": "Agent Scenario Loop Native Performance Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "providerId", "platform", "runId", "scenarioId"],
  "allOf": [
    {
      "if": {
        "properties": {
          "claimSufficiency": {
            "type": "object",
            "properties": {
              "status": { "const": "sufficient-for-comparison" }
            },
            "required": ["status"]
          }
        },
        "required": ["claimSufficiency"]
      },
      "then": {
        "required": ["comparability", "completenessStatus", "targetBinding"],
        "properties": {
          "comparability": {
            "type": "object",
            "properties": {
              "status": { "const": "comparable" }
            },
            "required": ["status"]
          },
          "completenessStatus": {
            "const": "complete"
          },
          "targetBinding": {
            "type": "object",
            "properties": {
              "status": { "const": "verified" }
            },
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "comparability": {
            "type": "object",
            "properties": {
              "status": { "const": "comparable" }
            },
            "required": ["status"]
          }
        },
        "required": ["comparability"]
      },
      "then": {
        "required": ["tool", "captureMode", "completenessStatus", "targetBinding"],
        "properties": {
          "tool": {
            "type": "object",
            "required": ["name"]
          },
          "captureMode": {
            "enum": ["passive-report", "session", "inline", "afterCapture", "postRun", "rehydrated"]
          },
          "completenessStatus": {
            "const": "complete"
          },
          "targetBinding": {
            "type": "object",
            "properties": {
              "status": { "const": "verified" }
            },
            "required": ["status"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.1.0"
          },
          "comparability": {
            "type": "object",
            "properties": {
              "status": { "const": "comparable" }
            },
            "required": ["status"]
          }
        },
        "required": ["schemaVersion", "comparability"]
      },
      "then": {
        "required": ["comparisonPolicy", "comparisonMetrics"],
        "properties": {
          "comparisonPolicy": {
            "required": ["policyId", "providerVersion", "window", "target", "environment"]
          },
          "comparisonMetrics": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "anyOf": [
    { "required": ["summary"] },
    { "required": ["metrics"] },
    { "required": ["frames"] },
    { "required": ["memory"] },
    { "required": ["events"] },
    { "required": ["traces"] },
    { "required": ["attachments"] },
    { "required": ["diagnosticSources"] }
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "enum": ["android", "ios", "unknown"]
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capturedAt": {
      "type": "string",
      "minLength": 1
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "clockDomain": {
      "type": "string",
      "minLength": 1
    },
    "captureMode": {
      "type": "string",
      "enum": ["passive-report", "session", "inline", "afterCapture", "postRun", "rehydrated", "unknown"]
    },
    "evidenceKind": {
      "type": "string",
      "enum": ["perfetto", "trace-processor", "gfxinfo", "framestats", "meminfo", "logcat-render", "instruments", "metrickit", "simctl", "native-trace", "diagnostic-summary", "mixed", "unknown"]
    },
    "dataClasses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["frames", "jank", "render", "memory", "cpu", "thread-scheduling", "io", "gpu", "network", "thermal", "battery", "native-trace", "unknown"]
      },
      "uniqueItems": true
    },
    "diagnosticSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["sourceId", "status"],
        "properties": {
          "sourceId": {
            "type": "string",
            "enum": ["perfetto", "trace-processor", "gfxinfo", "framestats", "meminfo", "logcat-render", "instruments", "xctrace", "metrickit", "simctl", "native-trace", "diagnostic-summary", "custom"]
          },
          "status": {
            "type": "string",
            "enum": ["captured", "partial", "failed", "timeout", "not-requested", "unsupported", "available-unproven", "unverified", "unknown"]
          },
          "tool": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "dataClasses": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["frames", "jank", "render", "memory", "cpu", "thread-scheduling", "io", "gpu", "network", "thermal", "battery", "native-trace", "unknown"]
            },
            "uniqueItems": true
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "nextAction": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "completenessStatus": {
      "type": "string",
      "enum": ["complete", "partial", "truncated", "failed", "unknown"]
    },
    "integrity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "missing", "corrupt", "redacted", "unknown"]
        },
        "sha256": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "redactionStatus": {
          "type": "string",
          "enum": ["none", "redacted", "contains-sensitive-data", "unknown"]
        },
        "corruptionStatus": {
          "type": "string",
          "enum": ["none", "corrupt", "unknown"]
        }
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["comparable", "diagnostic-only", "captured-not-comparable", "low-confidence", "incomplete", "unknown"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "comparisonPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "providerVersion", "window", "target", "environment"],
      "properties": {
        "policyId": {
          "type": "string",
          "minLength": 1
        },
        "providerVersion": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definitionId", "kind", "phase", "durationMs"],
          "properties": {
            "definitionId": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "phase": {
              "type": "string",
              "minLength": 1
            },
            "durationMs": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "buildMode"],
          "properties": {
            "family": {
              "type": "string",
              "minLength": 1
            },
            "buildMode": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "environment": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": ["string", "number", "boolean", "null"]
              }
            }
          }
        }
      }
    },
    "comparisonMetrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surface", "sample", "unit", "aggregation", "direction", "tolerance"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "surface": {
            "type": "string",
            "enum": ["frames", "memory", "metrics"]
          },
          "sample": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "enum": ["ms", "count", "bytes", "percent"]
          },
          "aggregation": {
            "type": "string",
            "enum": ["count", "last", "max", "mean", "p50", "p90", "p95", "p99", "sum"]
          },
          "direction": {
            "type": "string",
            "enum": ["lower-is-better", "higher-is-better"]
          },
          "tolerance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["absolute", "relative"],
            "properties": {
              "absolute": {
                "type": "number",
                "minimum": 0
              },
              "relative": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operator", "threshold"],
            "properties": {
              "operator": {
                "type": "string",
                "enum": ["at-most", "at-least"]
              },
              "threshold": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "claimSufficiency": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["sufficient-for-diagnosis", "insufficient-for-claim", "sufficient-for-comparison", "unknown"]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "nextAction": {
          "type": "string",
          "minLength": 1
        },
        "missingEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "supportingEvidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["beforeRun", "activeLoop", "afterCapture", "postRun", "rehydrated", "unknown"]
        },
        "startedAt": {
          "type": "string",
          "minLength": 1
        },
        "endedAt": {
          "type": "string",
          "minLength": 1
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "perturbsTiming": {
          "type": "boolean"
        }
      }
    },
    "targetBinding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["ambiguous", "mismatch"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["candidateTargets"]
          }
        }
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "ambiguous", "unverified", "mismatch", "unknown"]
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "appId": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "candidateTargets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["bindingStatus"],
            "anyOf": [
              { "required": ["deviceId"] },
              { "required": ["appId"] },
              { "required": ["source"] },
              { "required": ["evidencePath"] },
              { "required": ["reason"] }
            ],
            "properties": {
              "platform": {
                "type": "string",
                "enum": ["android", "ios", "unknown"]
              },
              "deviceId": {
                "type": "string",
                "minLength": 1
              },
              "deviceName": {
                "type": "string",
                "minLength": 1
              },
              "appId": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "evidencePath": {
                "type": "string",
                "minLength": 1
              },
              "bindingStatus": {
                "type": "string",
                "enum": ["expected", "observed", "conflicting", "unverified", "unknown"]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "string", "boolean", "null"]
      }
    },
    "frames": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "string", "boolean", "null"]
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "string", "boolean", "null"]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "traces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
