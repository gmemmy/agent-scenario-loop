{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/causal-run.schema.json",
  "title": "Agent Scenario Loop Causal Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "flowId",
    "runId",
    "platform",
    "buildFlavor",
    "scenario",
    "trigger",
    "budgets",
    "timeline",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "flowId": {
      "type": "string",
      "description": "Stable product-flow identifier such as startup, settings-open-close, or composer-open-close."
    },
    "runId": {
      "type": "string",
      "description": "Stable run identifier shared across profile artifacts, app-side signals, and UI Oracle evidence."
    },
    "platform": {
      "type": "string",
      "enum": ["ios", "android"]
    },
    "buildFlavor": {
      "type": "string",
      "enum": ["dev-debug", "dev-release", "prod-release", "unknown"]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "driver"],
      "properties": {
        "id": {
          "type": "string"
        },
        "driver": {
          "type": "string"
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "route": {
          "type": "string"
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["cold-launch", "resume", "tap", "gesture", "deeplink", "background-foreground", "unknown"]
        },
        "label": {
          "type": "string"
        },
        "targetId": {
          "type": "string"
        },
        "targetType": {
          "type": "string"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route": {
          "type": "string"
        },
        "authState": {
          "type": "string"
        },
        "networkState": {
          "type": "string"
        },
        "featureFlags": {
          "type": "object",
          "additionalProperties": {
            "type": ["boolean", "string", "number"]
          }
        }
      }
    },
    "provenanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "runId"],
      "properties": {
        "manifest": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "scenarioHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "budgets": {
      "type": "object",
      "description": "Named budget thresholds the run should be evaluated against.",
      "additionalProperties": {
        "$ref": "#/$defs/budgetThreshold"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timelineEvent"
      }
    },
    "iterationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "completed", "failed", "timeouts", "incomplete", "status"],
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 1
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "timeouts": {
          "type": "integer",
          "minimum": 0
        },
        "incomplete": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "status": {
          "type": "string",
          "enum": ["complete", "partial", "failed", "timeout"]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "signals"],
      "properties": {
        "summary": {
          "type": "string",
          "description": "Path to the human-readable summary for this run."
        },
        "metrics": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        },
        "video": {
          "type": "string"
        },
        "screenshot": {
          "type": ["string", "null"]
        },
        "nativeTrace": {
          "type": "string"
        },
        "uiOracleRun": {
          "type": "string"
        },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "js": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "memory": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "network": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "evidenceAttachments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "channel",
              "completenessStatus",
              "corruptionStatus",
              "kind",
              "path",
              "redactionStatus",
              "sha256",
              "sizeBytes",
              "sourceFileName",
              "transformations"
            ],
            "properties": {
              "channel": {
                "type": "string",
                "enum": ["capture", "provider", "signal"]
              },
              "completenessStatus": {
                "type": "string",
                "enum": ["complete", "truncated", "unknown"]
              },
              "corruptionStatus": {
                "type": "string",
                "enum": ["valid", "corrupt", "unknown"]
              },
              "kind": {
                "type": "string",
                "enum": ["accessibility", "js", "logs", "memory", "network", "profiler", "screenshot", "uiTree", "video"]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "redactionStatus": {
                "type": "string",
                "enum": ["not-redacted", "redacted", "unknown"]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0
              },
              "sourceFileName": {
                "type": "string",
                "minLength": 1
              },
              "transformations": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["copied", "normalized", "redacted", "truncated", "compressed", "transcoded", "unknown"]
                }
              }
            }
          }
        }
      }
    },
    "verdicts": {
      "type": "array",
      "items": {
        "$ref": "budget-verdict.schema.json"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "budgetThreshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "unit", "limit"],
      "properties": {
        "metric": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "enum": ["ms", "count", "bytes", "percent", "boolean"]
        },
        "limit": {
          "type": ["number", "integer", "boolean"]
        }
      }
    },
    "timelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "name", "atMs"],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "intent",
            "navigation",
            "domain",
            "query",
            "network",
            "render",
            "native",
            "visual",
            "completion"
          ]
        },
        "name": {
          "type": "string"
        },
        "atMs": {
          "type": "number"
        },
        "durationMs": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["started", "completed", "failed", "skipped", "observed"]
        },
        "owner": {
          "type": "string",
          "description": "Owning domain or subsystem such as startup, auth, viewer, navigation, or query."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      }
    }
  }
}
