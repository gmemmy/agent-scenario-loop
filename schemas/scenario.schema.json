{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/scenario.schema.json",
  "title": "Agent Scenario Loop Scenario",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": { "const": "1.0.0" }
        },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "journey": {
            "$ref": "#/$defs/journey"
          }
        },
        "allOf": [
          {
            "not": {
              "required": ["claims"],
              "description": "Legacy scenario schemaVersion 1.0.0 cannot declare claim-complete claims."
            }
          },
          {
            "not": {
              "required": ["safety"],
              "description": "Legacy scenario schemaVersion 1.0.0 cannot declare claim-complete safety."
            }
          }
        ]
      },
      "else": {
        "required": ["journey", "claims", "safety"],
        "properties": {
          "journey": {
            "$ref": "#/$defs/claimCompleteJourney"
          },
          "claims": {
            "contains": {
              "type": "object",
              "properties": {
                "role": { "const": "mandatory" }
              },
              "required": ["role"]
            }
          },
          "safety": {
            "$ref": "#/$defs/scenarioSafety"
          }
        }
      }
    }
  ],
  "required": [
    "schemaVersion",
    "id",
    "flowId",
    "platforms",
    "requiredCapabilities",
    "truthEvents",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0"]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "flowId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "comparisonLane": {
      "type": "string"
    },
    "acceptedBaselineScenarioHashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "description": {
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/scenarioMetadata"
    },
    "journey": {
      "oneOf": [
        { "$ref": "#/$defs/journey" },
        { "$ref": "#/$defs/claimCompleteJourney" }
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenarioClaim"
      }
    },
    "safety": {
      "$ref": "#/$defs/scenarioSafety"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["ios", "android"]
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "optionalCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "truthEvents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/truthMilestone"
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "expectedEvents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "cycles": {
      "$ref": "#/$defs/cycles"
    },
    "cadence": {
      "$ref": "#/$defs/cadencePolicy"
    },
    "budgets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/budget"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactKind"
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactKind"
          }
        }
      }
    },
    "adapterOptions": {
      "$ref": "#/$defs/adapterOptions"
    }
  },
  "$defs": {
    "scenarioMetadata": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metadataValue"
      },
      "properties": {
        "coverage": {
          "$ref": "#/$defs/coverageMetadata"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverageMetadata": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metadataValue"
      },
      "properties": {
        "featureSet": {
          "type": "string",
          "minLength": 1
        },
        "behaviorContract": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "coverageRole": {
          "type": "string",
          "enum": ["canonical", "stress", "degraded", "platform-specific", "diagnostic"]
        },
        "riskClass": {
          "type": "string",
          "minLength": 1
        },
        "platformContract": {
          "type": "string",
          "minLength": 1
        },
        "fixtureContract": {
          "type": "string",
          "minLength": 1
        },
        "evidenceTier": {
          "type": "string",
          "minLength": 1
        },
        "coverageStatus": {
          "type": "string",
          "minLength": 1
        },
        "ownerOnFailure": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadataValue": {
      "oneOf": [
        {
          "type": ["string", "number", "boolean", "null"]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadataValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/metadataValue"
          }
        }
      ]
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "intent"],
      "properties": {
        "name": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "startState": {
          "type": "string"
        },
        "endState": {
          "type": "string"
        }
      }
    },
    "claimCompleteJourney": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "intent",
        "actor",
        "startState",
        "endState",
        "phases",
        "terminalInvariants",
        "recovery"
      ],
      "properties": {
        "name": { "type": "string" },
        "intent": { "type": "string" },
        "actor": { "type": "string" },
        "startState": { "type": "string" },
        "endState": { "type": "string" },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/journeyContractItem"
          }
        },
        "terminalInvariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/journeyContractItem"
          }
        },
        "recovery": {
          "$ref": "#/$defs/recoveryContract"
        }
      }
    },
    "journeyContractItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "coverageKind"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "coverageKind": {
          "type": "string",
          "enum": ["product", "recovery"]
        }
      }
    },
    "recoveryContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["required", "not_required"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/journeyContractItem"
          }
        }
      }
    },
    "scenarioSafety": {
      "anyOf": [
        { "$ref": "#/$defs/readOnlyScenarioSafety" },
        { "$ref": "#/$defs/localMutationScenarioSafety" },
        { "$ref": "#/$defs/reversibleBackendMutationScenarioSafety" },
        { "$ref": "#/$defs/destructiveScenarioSafety" }
      ]
    },
    "readOnlyScenarioSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "rationale", "allowedOperations"],
      "properties": {
        "class": { "const": "read_only" },
        "rationale": { "type": "string", "minLength": 1 },
        "allowedOperations": { "$ref": "#/$defs/safetyOperations" }
      }
    },
    "localMutationScenarioSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "rationale",
        "allowedOperations",
        "mutationIdentity",
        "rollback",
        "cleanup",
        "reconciliation"
      ],
      "anyOf": [
        {
          "properties": {
            "rollback": { "$ref": "#/$defs/requiredSafetyAction" }
          }
        },
        {
          "properties": {
            "cleanup": { "$ref": "#/$defs/requiredSafetyAction" }
          }
        }
      ],
      "properties": {
        "class": { "const": "local_mutation" },
        "rationale": { "type": "string", "minLength": 1 },
        "allowedOperations": { "$ref": "#/$defs/safetyOperations" },
        "mutationIdentity": { "$ref": "#/$defs/safetyMutationIdentity" },
        "rollback": { "$ref": "#/$defs/safetyAction" },
        "cleanup": { "$ref": "#/$defs/safetyAction" },
        "reconciliation": { "$ref": "#/$defs/safetyReconciliation" }
      }
    },
    "reversibleBackendMutationScenarioSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "rationale",
        "allowedOperations",
        "mutationIdentity",
        "rollback",
        "cleanup",
        "reconciliation"
      ],
      "properties": {
        "class": { "const": "reversible_backend_mutation" },
        "rationale": { "type": "string", "minLength": 1 },
        "allowedOperations": { "$ref": "#/$defs/safetyOperations" },
        "mutationIdentity": { "$ref": "#/$defs/safetyMutationIdentity" },
        "rollback": { "$ref": "#/$defs/requiredSafetyAction" },
        "cleanup": { "$ref": "#/$defs/safetyAction" },
        "reconciliation": { "$ref": "#/$defs/safetyReconciliation" }
      }
    },
    "destructiveScenarioSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "rationale",
        "allowedOperations",
        "mutationIdentity",
        "rollback",
        "cleanup",
        "reconciliation"
      ],
      "properties": {
        "class": { "const": "destructive" },
        "rationale": { "type": "string", "minLength": 1 },
        "allowedOperations": { "$ref": "#/$defs/safetyOperations" },
        "mutationIdentity": { "$ref": "#/$defs/safetyMutationIdentity" },
        "rollback": { "$ref": "#/$defs/safetyAction" },
        "cleanup": { "$ref": "#/$defs/requiredSafetyAction" },
        "reconciliation": { "$ref": "#/$defs/safetyReconciliation" }
      }
    },
    "safetyOperations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "safetyMutationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assertionIds"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "assertionIds": { "$ref": "#/$defs/safetyAssertionIds" }
      }
    },
    "safetyAction": {
      "anyOf": [
        { "$ref": "#/$defs/requiredSafetyAction" },
        { "$ref": "#/$defs/notRequiredSafetyAction" }
      ]
    },
    "requiredSafetyAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "assertionIds"],
      "properties": {
        "status": { "const": "required" },
        "rationale": { "type": "string", "minLength": 1 },
        "assertionIds": { "$ref": "#/$defs/safetyAssertionIds" }
      }
    },
    "notRequiredSafetyAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": { "const": "not_required" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "safetyReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminalInvariantIds", "assertionIds"],
      "properties": {
        "terminalInvariantIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "assertionIds": { "$ref": "#/$defs/safetyAssertionIds" }
      }
    },
    "safetyAssertionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stableId" }
    },
    "scenarioClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "applicability", "closes", "assertions"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "role": {
          "$ref": "#/$defs/claimRole"
        },
        "applicability": {
          "$ref": "#/$defs/claimApplicability"
        },
        "closes": {
          "$ref": "#/$defs/claimClosure"
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claimAssertion"
          }
        }
      }
    },
    "claimRole": {
      "type": "string",
      "enum": ["mandatory", "supplemental"]
    },
    "claimApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ios", "android"]
          }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claimClosure": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["phases"] },
        { "required": ["terminalInvariants"] }
      ],
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "terminalInvariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "claimAssertion": {
      "anyOf": [
        { "$ref": "#/$defs/eventOccurrenceAssertion" },
        { "$ref": "#/$defs/eventOrderAssertion" },
        { "$ref": "#/$defs/terminalStateAssertion" },
        { "$ref": "#/$defs/boundedCountAssertion" },
        { "$ref": "#/$defs/absenceAssertion" },
        { "$ref": "#/$defs/validatedEvidenceAssertion" }
      ]
    },
    "claimAssertionBase": {
      "type": "object",
      "required": ["id", "kind", "authority"],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "type": "string"
        },
        "authority": {
          "$ref": "#/$defs/claimAuthority"
        }
      }
    },
    "eventOccurrenceAssertion": {
      "allOf": [
        { "$ref": "#/$defs/claimAssertionBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "authority", "event"],
          "properties": {
            "id": { "$ref": "#/$defs/stableId" },
            "kind": { "const": "eventOccurrence" },
            "authority": { "$ref": "#/$defs/claimAuthority" },
            "event": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "eventOrderAssertion": {
      "allOf": [
        { "$ref": "#/$defs/claimAssertionBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "authority", "beforeEvent", "afterEvent"],
          "properties": {
            "id": { "$ref": "#/$defs/stableId" },
            "kind": { "const": "eventOrder" },
            "authority": { "$ref": "#/$defs/claimAuthority" },
            "beforeEvent": { "type": "string", "minLength": 1 },
            "afterEvent": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "terminalStateAssertion": {
      "allOf": [
        { "$ref": "#/$defs/claimAssertionBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "authority", "path", "expected"],
          "properties": {
            "id": { "$ref": "#/$defs/stableId" },
            "kind": { "const": "terminalState" },
            "authority": { "$ref": "#/$defs/claimAuthority" },
            "path": { "type": "string", "minLength": 1 },
            "expected": { "type": ["string", "number", "boolean", "null"] }
          }
        }
      ]
    },
    "boundedCountAssertion": {
      "allOf": [
        { "$ref": "#/$defs/claimAssertionBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            { "required": ["minimum"] },
            { "required": ["maximum"] }
          ],
          "required": ["id", "kind", "authority", "selector", "observationWindow"],
          "properties": {
            "id": { "$ref": "#/$defs/stableId" },
            "kind": { "const": "boundedCount" },
            "authority": { "$ref": "#/$defs/windowedClaimAuthority" },
            "selector": { "type": "string", "minLength": 1 },
            "observationWindow": { "$ref": "#/$defs/claimObservationWindow" },
            "minimum": { "type": "integer", "minimum": 0 },
            "maximum": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "absenceAssertion": {
      "allOf": [
        { "$ref": "#/$defs/claimAssertionBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "authority", "selector", "observationWindow"],
          "properties": {
            "id": { "$ref": "#/$defs/stableId" },
            "kind": { "const": "absence" },
            "authority": { "$ref": "#/$defs/windowedClaimAuthority" },
            "selector": { "type": "string", "minLength": 1 },
            "observationWindow": { "$ref": "#/$defs/claimObservationWindow" }
          }
        }
      ]
    },
    "validatedEvidenceAssertion": {
      "allOf": [
        { "$ref": "#/$defs/claimAssertionBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "authority", "artifactKind", "validationContract"],
          "properties": {
            "id": { "$ref": "#/$defs/stableId" },
            "kind": { "const": "validatedEvidence" },
            "authority": { "$ref": "#/$defs/claimAuthority" },
            "artifactKind": { "$ref": "#/$defs/artifactKind" },
            "validationContract": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "claimAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "producerId", "evidenceSelector", "requiredStrength", "completeness"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["app", "runner", "adapter", "provider", "comparator"]
        },
        "producerId": { "type": "string", "minLength": 1 },
        "evidenceSelector": { "type": "string", "minLength": 1 },
        "requiredStrength": {
          "type": "string",
          "enum": ["observed", "verified"]
        },
        "completeness": {
          "type": "string",
          "enum": ["point", "bounded", "continuous-complete"]
        }
      }
    },
    "windowedClaimAuthority": {
      "allOf": [
        { "$ref": "#/$defs/claimAuthority" },
        {
          "properties": {
            "completeness": {
              "type": "string",
              "enum": ["bounded", "continuous-complete"]
            }
          }
        }
      ]
    },
    "claimObservationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "completeSourceRequired"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "completeSourceRequired": { "const": true }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "cycles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "warmupIterations": {
          "type": "integer",
          "minimum": 0
        },
        "stopOnFailure": {
          "type": "boolean",
          "default": true
        },
        "setupStepIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "bodyStepIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capability": {
      "type": "string",
      "enum": [
        "launch",
        "sessionControl",
        "command",
        "logCapture",
        "artifactWrite",
        "screenshot",
        "video",
        "uiTree",
        "memory",
        "nativePerformance",
        "network",
        "profiler",
        "accessibility"
      ]
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "logs",
        "screenshot",
        "video",
        "uiTree",
        "memory",
        "nativePerformance",
        "network",
        "profiler",
        "accessibility",
        "signals"
      ]
    },
    "truthMilestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "type": "string",
          "enum": [
            "intent",
            "navigation",
            "domain",
            "query",
            "network",
            "render",
            "native",
            "visual",
            "completion"
          ]
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "event"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "event": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "type": "string",
          "enum": [
            "intent",
            "navigation",
            "domain",
            "query",
            "network",
            "render",
            "native",
            "visual",
            "completion"
          ]
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "metric", "unit", "limit"],
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": ["milestone", "artifact"]
        },
        "metric": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "enum": ["ms", "count", "bytes", "percent", "boolean"]
        },
        "limit": {
          "type": ["number", "integer", "boolean"]
        },
        "fromMilestone": {
          "type": "string",
          "description": "Optional start milestone for interval timing. When paired with toMilestone on a milestone timing budget, ASL measures toMilestone - fromMilestone for each iteration."
        },
        "toMilestone": {
          "type": "string",
          "description": "Target milestone for milestone timing. Without fromMilestone, ASL measures elapsed time from the run or session clock origin to this milestone occurrence."
        },
        "artifact": {
          "$ref": "#/$defs/artifactKind"
        }
      }
    },
    "cadencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultSettleMs": {
          "type": "integer",
          "minimum": 0
        },
        "launchSettleMs": {
          "type": "integer",
          "minimum": 0
        },
        "commandSettleMs": {
          "type": "integer",
          "minimum": 0
        },
        "gestureSettleMs": {
          "type": "integer",
          "minimum": 0
        },
        "assertionSettleMs": {
          "type": "integer",
          "minimum": 0
        },
        "captureSettleMs": {
          "type": "integer",
          "minimum": 0
        },
        "waitSettleMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stepCadence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "settleMs": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "launch",
            "command",
            "waitForMilestone",
            "captureEvidence",
            "gesture",
            "assertUi"
          ]
        },
        "command": {
          "type": "string"
        },
        "milestone": {
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/artifactKind"
        },
        "driverAction": {
          "$ref": "#/$defs/driverAction"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "uiContext": {
          "$ref": "#/$defs/uiContext"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "cadence": {
          "$ref": "#/$defs/stepCadence"
        },
        "adapterOptions": {
          "$ref": "#/$defs/adapterOptions"
        }
      }
    },
    "adapterOptions": {
      "type": "object",
      "additionalProperties": true
    },
    "driverAction": {
      "type": "string",
      "enum": [
        "tap",
        "longPress",
        "scroll",
        "swipe",
        "drag",
        "pinch",
        "rotate",
        "rotateGesture",
        "typeText",
        "focus",
        "fill",
        "pressKey",
        "pressButton",
        "assertVisible",
        "inspectTree",
        "screenshot",
        "record",
        "readLogs",
        "collectPerfSignals",
        "customGesture",
        "runSequence"
      ]
    },
    "uiContext": {
      "type": "string",
      "enum": [
        "app",
        "systemDialog",
        "notificationShade",
        "externalBrowser",
        "webView",
        "shareSheet",
        "picker",
        "otherApp"
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "testId",
            "accessibilityId",
            "accessibilityLabel",
            "text",
            "resourceId",
            "xpath"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": "string",
          "enum": ["exact", "contains", "regex"]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ios", "android"]
          }
        }
      }
    }
  }
}
