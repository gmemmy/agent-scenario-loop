{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/scenario.schema.json",
  "title": "Agent Scenario Loop Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "flowId",
    "platforms",
    "requiredCapabilities",
    "truthEvents",
    "steps"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "flowId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "comparisonLane": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "journey": {
      "$ref": "#/$defs/journey"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["ios", "android"]
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "optionalCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "truthEvents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/truthMilestone"
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "expectedEvents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "cycles": {
      "$ref": "#/$defs/cycles"
    },
    "budgets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/budget"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactKind"
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactKind"
          }
        }
      }
    },
    "adapterOptions": {
      "$ref": "#/$defs/adapterOptions"
    }
  },
  "$defs": {
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "intent"],
      "properties": {
        "name": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "startState": {
          "type": "string"
        },
        "endState": {
          "type": "string"
        }
      }
    },
    "cycles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "warmupIterations": {
          "type": "integer",
          "minimum": 0
        },
        "stopOnFailure": {
          "type": "boolean",
          "default": true
        },
        "setupStepIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "bodyStepIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capability": {
      "type": "string",
      "enum": [
        "launch",
        "sessionControl",
        "command",
        "logCapture",
        "artifactWrite",
        "screenshot",
        "video",
        "uiTree",
        "memory",
        "nativePerformance",
        "network",
        "profiler",
        "accessibility"
      ]
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "logs",
        "screenshot",
        "video",
        "uiTree",
        "memory",
        "nativePerformance",
        "network",
        "profiler",
        "accessibility",
        "signals"
      ]
    },
    "truthMilestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "type": "string",
          "enum": [
            "intent",
            "navigation",
            "domain",
            "query",
            "network",
            "render",
            "native",
            "visual",
            "completion"
          ]
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "event"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "event": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "phase": {
          "type": "string",
          "enum": [
            "intent",
            "navigation",
            "domain",
            "query",
            "network",
            "render",
            "native",
            "visual",
            "completion"
          ]
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "metric", "unit", "limit"],
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": ["milestone", "artifact"]
        },
        "metric": {
          "type": "string"
        },
        "unit": {
          "type": "string",
          "enum": ["ms", "count", "bytes", "percent", "boolean"]
        },
        "limit": {
          "type": ["number", "integer", "boolean"]
        },
        "fromMilestone": {
          "type": "string",
          "description": "Optional start milestone for interval timing. When paired with toMilestone on a milestone timing budget, ASL measures toMilestone - fromMilestone for each iteration."
        },
        "toMilestone": {
          "type": "string",
          "description": "Target milestone for milestone timing. Without fromMilestone, ASL measures elapsed time from the run or session clock origin to this milestone occurrence."
        },
        "artifact": {
          "$ref": "#/$defs/artifactKind"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "launch",
            "command",
            "waitForMilestone",
            "captureEvidence",
            "gesture",
            "assertUi"
          ]
        },
        "command": {
          "type": "string"
        },
        "milestone": {
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/artifactKind"
        },
        "driverAction": {
          "$ref": "#/$defs/driverAction"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "uiContext": {
          "$ref": "#/$defs/uiContext"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "adapterOptions": {
          "$ref": "#/$defs/adapterOptions"
        }
      }
    },
    "adapterOptions": {
      "type": "object",
      "additionalProperties": true
    },
    "driverAction": {
      "type": "string",
      "enum": [
        "tap",
        "longPress",
        "swipe",
        "scroll",
        "drag",
        "pinch",
        "rotate",
        "customGesture",
        "typeText",
        "pressKey",
        "pressButton",
        "runSequence",
        "assertVisible",
        "inspectTree",
        "screenshot",
        "record",
        "readLogs",
        "collectPerfSignals"
      ]
    },
    "uiContext": {
      "type": "string",
      "enum": [
        "app",
        "systemDialog",
        "notificationShade",
        "externalBrowser",
        "webView",
        "nativePreview",
        "shareSheet",
        "picker",
        "otherApp"
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "testId",
            "accessibilityId",
            "accessibilityLabel",
            "text",
            "resourceId",
            "xpath"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": "string",
          "enum": ["exact", "contains", "regex"]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["ios", "android"]
          }
        }
      }
    }
  }
}
