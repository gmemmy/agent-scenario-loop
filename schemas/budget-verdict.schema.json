{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scenario-loop.dev/schemas/budget-verdict.schema.json",
  "title": "Agent Scenario Loop Budget Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "flowId",
    "runId",
    "status",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "flowId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "partial"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "metric", "unit", "expected", "actual", "pass"],
        "properties": {
          "name": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "enum": ["ms", "count", "bytes", "percent", "boolean"]
          },
          "expected": {
            "type": ["number", "integer", "boolean"]
          },
          "actual": {
            "type": ["number", "integer", "boolean", "null"]
          },
          "pass": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "unmeasurable"]
          },
          "sourceEvent": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "visualOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "manual-review-needed"]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["passed", "failed", "manual-review-needed"]
              },
              "artifact": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baselineRunId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["better", "worse", "unchanged", "unknown"]
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
