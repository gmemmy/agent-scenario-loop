{
  "name": "app-startup-video",
  "flowId": "example-startup-video",
  "description": "Cold-launch the example app on Android while recording an optional adb video capture.",
  "type": "app-startup",
  "platform": "android",
  "interactionDriver": "fixture-log-ingest",
  "trigger": {
    "kind": "cold-launch",
    "label": "Launch the example app from a terminated state and preserve a video capture when adb owns the window."
  },
  "adapterOptions": {
    "androidAdb": {
      "commands": [],
      "repeat": 1
    }
  },
  "defaultIterations": 1,
  "steps": [
    {
      "id": "capture-log-window",
      "kind": "captureEvidence",
      "artifact": "logs",
      "driverAction": "readLogs",
      "adapterOptions": {
        "androidAdb": {
          "logcatLines": 1000,
          "rawFileName": "adb-logcat.txt"
        }
      }
    },
    {
      "id": "record-startup-window",
      "kind": "captureEvidence",
      "artifact": "video",
      "driverAction": "record",
      "required": false,
      "adapterOptions": {
        "androidAdb": {
          "captureFileName": "app-startup-video.mp4",
          "durationSeconds": 5,
          "rawFileName": "adb-record-startup.txt",
          "remotePath": "/sdcard/asl-app-startup-video.mp4"
        }
      }
    }
  ],
  "timelinePhases": {
    "app_launch_requested": "intent",
    "home_ready": "visual",
    "startup_idle_observed": "render",
    "startup_complete": "completion"
  },
  "metricEvents": {
    "openRequested": "app_launch_requested",
    "opened": "home_ready",
    "closeRequested": "startup_idle_observed",
    "dismissed": "startup_complete"
  },
  "budgets": {
    "metric": "example android startup ready with video",
    "pass": {
      "failures": 0,
      "timeouts": 0,
      "cycleP50Ms": 1700,
      "cycleP95Ms": 1700,
      "openP50Ms": 1300,
      "openP95Ms": 1300,
      "closeP50Ms": 300,
      "closeP95Ms": 300
    }
  }
}
