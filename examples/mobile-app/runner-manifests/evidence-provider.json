{
  "schemaVersion": "1.0.0",
  "runnerId": "example-mobile-app-profiler-provider",
  "kind": "evidenceProvider",
  "platforms": ["ios", "android"],
  "capabilities": ["memory", "network", "profiler"],
  "driverActions": ["collectPerfSignals"],
  "artifactOutputs": ["memory", "network", "profiler", "signals"],
  "lifecycle": ["prepare", "startWindow", "capture", "stopWindow", "finalize"],
  "providerCommands": [
    {
      "id": "capture-profiler",
      "phase": "capture",
      "command": "node",
      "cwd": "..",
      "args": [
        "scripts/asl-capture-profiler-provider.mjs",
        "--platform",
        "{platform}",
        "--scenario",
        "{scenarioId}",
        "--run-id",
        "{runId}",
        "--out",
        "{providerDir}/profiler.json",
        "--memory-out",
        "{providerDir}/memory.json",
        "--network-out",
        "{providerDir}/network.har"
      ],
      "outputs": [
        {
          "channel": "provider",
          "kind": "profiler",
          "path": "{providerDir}/profiler.json"
        },
        {
          "channel": "signal",
          "kind": "js",
          "path": "{providerDir}/profiler.json"
        },
        {
          "channel": "signal",
          "kind": "memory",
          "path": "{providerDir}/memory.json"
        },
        {
          "channel": "signal",
          "kind": "network",
          "path": "{providerDir}/network.har"
        }
      ]
    }
  ]
}
