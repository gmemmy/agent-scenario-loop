{
  "schemaVersion": "1.0.0",
  "runnerId": "argent-ios",
  "kind": "primary",
  "platforms": ["ios"],
  "capabilities": [
    "launch",
    "sessionControl",
    "command",
    "logCapture",
    "artifactWrite",
    "screenshot",
    "uiTree"
  ],
  "driverActions": ["tap", "scroll", "assertVisible", "inspectTree", "screenshot"],
  "artifactOutputs": ["logs", "signals", "screenshot", "uiTree"],
  "uiContexts": ["app"],
  "lifecycle": [
    "prepare",
    "launch",
    "startSession",
    "executeStep",
    "waitForTruthEvent",
    "captureEvidence",
    "stopSession",
    "finalize"
  ],
  "adapterOptionsSchema": {
    "nativeDevtoolsRequired": true,
    "failHealthOnRestartRequired": true,
    "failHealthOnRootOnlyTree": true
  }
}
