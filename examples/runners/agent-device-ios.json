{
  "schemaVersion": "1.0.0",
  "runnerId": "agent-device-ios",
  "kind": "primary",
  "platforms": ["ios"],
  "capabilities": [
    "launch",
    "sessionControl",
    "command",
    "logCapture",
    "artifactWrite",
    "screenshot",
    "uiTree"
  ],
  "driverActions": ["tap", "typeText", "scroll", "swipe", "assertVisible", "inspectTree", "screenshot", "readLogs"],
  "artifactOutputs": ["logs", "signals", "screenshot", "uiTree"],
  "uiContexts": ["app"],
  "lifecycle": [
    "prepare",
    "launch",
    "startSession",
    "executeStep",
    "waitForTruthEvent",
    "captureEvidence",
    "stopSession",
    "finalize"
  ]
}
