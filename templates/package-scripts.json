{
  "asl:check:ios": "asl-check-plan --scenario scenarios/mobile/{{SCENARIO_ID}}.json --runner runner-manifests/primary-runner.json --platform ios --out artifacts/asl/plan/{{SCENARIO_ID}}-ios",
  "asl:check:android": "asl-check-plan --scenario scenarios/mobile/{{SCENARIO_ID}}.json --runner runner-manifests/primary-runner.json --platform android --out artifacts/asl/plan/{{SCENARIO_ID}}-android",
  "asl:validate": "asl-validate-project --root . --platform all --out artifacts/asl/project-validation",
  "asl:profile:ios": "asl-profile-ios --config asl.config.json --scenario scenarios/mobile/{{SCENARIO_ID}}.json --out artifacts/asl/ios --run-id {{SCENARIO_ID}}-ios",
  "asl:profile:android": "asl-profile-android --config asl.config.json --scenario scenarios/mobile/{{SCENARIO_ID}}.json --out artifacts/asl/android --run-id {{SCENARIO_ID}}-android",
  "asl:compare:ios": "asl-compare-latest --root artifacts/asl/ios --scenario {{SCENARIO_ID}} --current <run-dir> --out artifacts/asl/ios/comparisons/{{SCENARIO_ID}}",
  "asl:compare:android": "asl-compare-latest --root artifacts/asl/android --scenario {{SCENARIO_ID}} --current <run-dir> --out artifacts/asl/android/comparisons/{{SCENARIO_ID}}",
  "asl:live-proof": "asl-live-proof --file <live-proof.json> --fail-on-regression"
}
