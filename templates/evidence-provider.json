{
  "schemaVersion": "1.0.0",
  "runnerId": "example-profiler-provider",
  "kind": "evidenceProvider",
  "platforms": ["ios", "android"],
  "capabilities": ["profiler"],
  "driverActions": ["collectPerfSignals"],
  "artifactOutputs": ["profiler", "signals"],
  "lifecycle": ["prepare", "startWindow", "capture", "stopWindow", "finalize"],
  "providerCommands": [
    {
      "id": "capture-profiler",
      "phase": "capture",
      "command": "node",
      "cwd": "..",
      "args": [
        "scripts/asl-capture-profiler-provider.mjs",
        "--platform",
        "{platform}",
        "--scenario",
        "{scenarioId}",
        "--run-id",
        "{runId}",
        "--out",
        "{providerDir}/profiler.json"
      ],
      "outputs": [
        {
          "channel": "provider",
          "kind": "profiler",
          "path": "{providerDir}/profiler.json"
        },
        {
          "channel": "signal",
          "kind": "js",
          "path": "{providerDir}/profiler.json"
        }
      ]
    }
  ],
  "adapterOptionsSchema": {
    "signalPath": "signals/js",
    "window": "scenario"
  }
}
