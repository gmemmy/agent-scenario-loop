{
  "schemaVersion": "1.1.0",
  "runnerId": "example-evidence-provider",
  "kind": "evidenceProvider",
  "platforms": ["ios", "android"],
  "capabilities": ["accessibility", "memory", "nativePerformance", "network", "profiler"],
  "driverActions": ["collectPerfSignals"],
  "artifactOutputs": ["accessibility", "memory", "nativePerformance", "network", "profiler", "signals"],
  "lifecycle": ["prepare", "startWindow", "capture", "stopWindow", "afterCapture", "finalize"],
  "providerCommands": [
    {
      "id": "start-android-native-window",
      "phase": "startWindow",
      "platforms": ["android"],
      "command": "node",
      "cwd": "..",
      "args": [
        "scripts/asl-capture-native-performance-provider.mjs",
        "start-window",
        "--platform",
        "{platform}",
        "--app-id",
        "{appId}",
        "--target-id",
        "{targetId}",
        "--provider-id",
        "{providerId}",
        "--provider-dir",
        "{providerDir}",
        "--run-id",
        "{runId}",
        "--run-dir",
        "{runDir}",
        "--scenario",
        "{scenarioId}",
        "--target-binding",
        "{nativeTargetBindingPath}",
        "--request",
        "{nativePerformanceRequestPath}",
        "--request-sha256",
        "{nativePerformanceRequestSha256}"
      ],
      "outputs": []
    },
    {
      "id": "start-native-window",
      "phase": "startWindow",
      "platforms": ["ios"],
      "command": "node",
      "cwd": "..",
      "args": [
        "scripts/asl-capture-native-performance-provider.mjs",
        "start-window",
        "--platform",
        "{platform}",
        "--app-id",
        "{appId}",
        "--target-id",
        "{targetId}",
        "--provider-id",
        "{providerId}",
        "--provider-dir",
        "{providerDir}",
        "--run-id",
        "{runId}",
        "--run-dir",
        "{runDir}",
        "--scenario",
        "{scenarioId}",
        "--target-binding",
        "{nativeTargetBindingPath}",
        "--request",
        "{nativePerformanceRequestPath}",
        "--request-sha256",
        "{nativePerformanceRequestSha256}"
      ],
      "outputs": []
    },
    {
      "id": "stop-android-native-window",
      "phase": "stopWindow",
      "platforms": ["android"],
      "command": "node",
      "cwd": "..",
      "args": [
        "scripts/asl-capture-native-performance-provider.mjs",
        "stop-window",
        "--platform",
        "{platform}",
        "--app-id",
        "{appId}",
        "--target-id",
        "{targetId}",
        "--provider-id",
        "{providerId}",
        "--provider-dir",
        "{providerDir}",
        "--run-id",
        "{runId}",
        "--run-dir",
        "{runDir}",
        "--scenario",
        "{scenarioId}",
        "--target-binding",
        "{nativeTargetBindingPath}",
        "--request",
        "{nativePerformanceRequestPath}",
        "--request-sha256",
        "{nativePerformanceRequestSha256}"
      ],
      "outputs": [
        {
          "channel": "provider",
          "kind": "logs",
          "path": "{providerDir}/android-adb/target-serial.stdout.txt"
        },
        {
          "channel": "provider",
          "kind": "logs",
          "path": "{providerDir}/android-adb/target-package.stdout.txt"
        },
        {
          "channel": "provider",
          "kind": "logs",
          "path": "{providerDir}/android-adb/target-process.stdout.txt"
        },
        {
          "channel": "provider",
          "kind": "logs",
          "path": "{providerDir}/android-adb/gfxinfo.stdout.txt"
        },
        {
          "channel": "provider",
          "kind": "logs",
          "path": "{providerDir}/android-adb/framestats.stdout.txt"
        },
        {
          "channel": "provider",
          "kind": "logs",
          "path": "{providerDir}/android-adb/meminfo.stdout.txt"
        }
      ]
    },
    {
      "id": "stop-native-window",
      "phase": "stopWindow",
      "platforms": ["ios"],
      "command": "node",
      "cwd": "..",
      "args": [
        "scripts/asl-capture-native-performance-provider.mjs",
        "stop-window",
        "--platform",
        "{platform}",
        "--app-id",
        "{appId}",
        "--target-id",
        "{targetId}",
        "--provider-id",
        "{providerId}",
        "--provider-dir",
        "{providerDir}",
        "--run-id",
        "{runId}",
        "--run-dir",
        "{runDir}",
        "--scenario",
        "{scenarioId}",
        "--target-binding",
        "{nativeTargetBindingPath}",
        "--request",
        "{nativePerformanceRequestPath}",
        "--request-sha256",
        "{nativePerformanceRequestSha256}"
      ],
      "outputs": []
    },
    {
      "id": "capture-accessibility",
      "phase": "afterCapture",
      "command": "node",
      "cwd": "..",
      "args": [
        "scripts/asl-capture-accessibility-provider.mjs",
        "--platform",
        "{platform}",
        "--scenario",
        "{scenarioId}",
        "--run-id",
        "{runId}",
        "--run-dir",
        "{runDir}",
        "--out",
        "{providerDir}/accessibility.json"
      ],
      "outputs": [
        {
          "channel": "provider",
          "kind": "accessibility",
          "path": "{providerDir}/accessibility.json"
        }
      ]
    },
    {
      "id": "capture-profiler",
      "phase": "afterCapture",
      "command": "node",
      "cwd": "..",
      "args": [
        "scripts/asl-capture-profiler-provider.mjs",
        "--platform",
        "{platform}",
        "--scenario",
        "{scenarioId}",
        "--run-id",
        "{runId}",
        "--run-dir",
        "{runDir}",
        "--out",
        "{providerDir}/profiler.json",
        "--memory-out",
        "{providerDir}/memory.json",
        "--network-out",
        "{providerDir}/network.har"
      ],
      "outputs": [
        {
          "channel": "provider",
          "kind": "profiler",
          "path": "{providerDir}/profiler.json"
        },
        {
          "channel": "signal",
          "kind": "js",
          "path": "{providerDir}/profiler.json"
        },
        {
          "channel": "signal",
          "kind": "memory",
          "path": "{providerDir}/memory.json"
        },
        {
          "channel": "signal",
          "kind": "network",
          "path": "{providerDir}/network.har"
        }
      ]
    },
    {
      "id": "capture-native-performance",
      "phase": "afterCapture",
      "command": "node",
      "cwd": "..",
      "args": [
        "scripts/asl-capture-native-performance-provider.mjs",
        "--platform",
        "{platform}",
        "--app-id",
        "{appId}",
        "--target-id",
        "{targetId}",
        "--provider-id",
        "{providerId}",
        "--provider-dir",
        "{providerDir}",
        "--scenario",
        "{scenarioId}",
        "--run-id",
        "{runId}",
        "--run-dir",
        "{runDir}",
        "--target-binding",
        "{nativeTargetBindingPath}",
        "--request",
        "{nativePerformanceRequestPath}",
        "--request-sha256",
        "{nativePerformanceRequestSha256}",
        "--out",
        "{providerDir}/native-performance.json"
      ],
      "outputs": [
        {
          "channel": "provider",
          "kind": "nativePerformance",
          "path": "{providerDir}/native-performance.json"
        }
      ]
    },
    {
      "id": "finalize-native-window",
      "phase": "finalize",
      "command": "node",
      "cwd": "..",
      "args": [
        "scripts/asl-capture-native-performance-provider.mjs",
        "finalize",
        "--platform",
        "{platform}",
        "--app-id",
        "{appId}",
        "--target-id",
        "{targetId}",
        "--provider-id",
        "{providerId}",
        "--provider-dir",
        "{providerDir}",
        "--run-id",
        "{runId}",
        "--run-dir",
        "{runDir}",
        "--scenario",
        "{scenarioId}",
        "--target-binding",
        "{nativeTargetBindingPath}",
        "--request",
        "{nativePerformanceRequestPath}",
        "--request-sha256",
        "{nativePerformanceRequestSha256}"
      ],
      "outputs": []
    }
  ],
  "adapterOptionsSchema": {
    "signalPath": "signals/js",
    "window": "scenario"
  }
}
